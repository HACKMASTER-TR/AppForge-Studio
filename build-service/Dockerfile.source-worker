FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:e1ffd2a92ae84c1291bc1b6887501f8af98e6331e7af6d4c8d37168c5e87a64c AS dotnet-sdk

FROM node:22-bookworm-slim

ARG ANDROID_CMDLINE_TOOLS_VERSION=15859902
ARG ANDROID_CMDLINE_TOOLS_SHA256=4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583
ARG ANDROID_SDK_LICENSE_ACCEPTED=false
ARG GRADLE_VERSION=9.3.1
ARG REACT_NATIVE_GRADLE_VERSION=8.14.3
ARG FLUTTER_VERSION=3.44.9
ARG FLUTTER_SHA256=a9120fa4a01048bdef438ddc3a2d4b7389662ea98a95db86eeaf10382bc4efcb

ENV DEBIAN_FRONTEND=noninteractive
ENV DOTNET_ROOT=/usr/share/dotnet
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1
ENV DOTNET_NOLOGO=1
ENV NUGET_XMLDOC_MODE=skip
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_NDK_HOME=/opt/android-sdk/ndk/28.2.13676358
ENV ANDROID_NDK_ROOT=/opt/android-sdk/ndk/28.2.13676358
ENV GRADLE_HOME=/opt/gradle/gradle-9.3.1
ENV REACT_NATIVE_GRADLE_HOME=/opt/gradle/gradle-8.14.3
ENV FLUTTER_HOME=/opt/flutter
ENV PATH=/usr/share/dotnet:/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:/opt/gradle/gradle-9.3.1/bin:/opt/android-sdk/platform-tools:/opt/android-sdk/cmdline-tools/latest/bin:$PATH
ENV NODE_ENV=production

COPY --from=dotnet-sdk /usr/share/dotnet /usr/share/dotnet

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       curl \
       unzip \
       git \
       xz-utils \
       cmake \
       ninja-build \
       libicu72 \
       libssl3 \
       zlib1g \
       python3 \
       python3-pip \
       openjdk-17-jdk-headless \
    && rm -rf /var/lib/apt/lists/*

# Android command-line tools: pin file + verify SHA-256 from Android Developers.
RUN mkdir -p /opt/android-sdk/cmdline-tools \
    && curl -fL --retry 4 \
       "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS_VERSION}_latest.zip" \
       -o /tmp/android-commandline-tools.zip \
    && echo "${ANDROID_CMDLINE_TOOLS_SHA256}  /tmp/android-commandline-tools.zip" | sha256sum -c - \
    && mkdir -p /tmp/android-tools \
    && unzip -q /tmp/android-commandline-tools.zip -d /tmp/android-tools \
    && mkdir -p /opt/android-sdk/cmdline-tools/latest \
    && mv /tmp/android-tools/cmdline-tools/* /opt/android-sdk/cmdline-tools/latest/ \
    && rm -rf /tmp/android-tools /tmp/android-commandline-tools.zip

# SDK license acceptance is intentionally explicit.
# Build with:
#   ANDROID_SDK_LICENSE_ACCEPTED=true docker compose build worker
RUN if [ "${ANDROID_SDK_LICENSE_ACCEPTED}" != "true" ]; then \
      echo "ERROR: Android SDK lisansını kabul ettiysen ANDROID_SDK_LICENSE_ACCEPTED=true ile worker imajını oluştur."; \
      exit 42; \
    fi \
    && yes | sdkmanager --licenses >/dev/null \
    && sdkmanager --channel=3 \
       "platform-tools" \
       "platforms;android-36" \
       "platforms;android-37.0" \
       "build-tools;36.0.0" \
       "ndk;28.2.13676358" \
       "cmake;3.22.1"

# AGP 9.1 requires Gradle 9.3.1 minimum. Verify Gradle's published checksum.
RUN curl -fL --retry 4 \
      "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" \
      -o /tmp/gradle.zip \
    && curl -fL --retry 4 \
      "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip.sha256" \
      -o /tmp/gradle.zip.sha256 \
    && printf "%s  %s\n" "$(cat /tmp/gradle.zip.sha256)" "/tmp/gradle.zip" | sha256sum -c - \
    && mkdir -p /opt/gradle \
    && unzip -q /tmp/gradle.zip -d /opt/gradle \
    && rm /tmp/gradle.zip /tmp/gradle.zip.sha256



# React Native / Expo current Android projects commonly use Gradle 8.x.
# Install a trusted system Gradle instead of executing uploaded gradle-wrapper.jar.
RUN curl -fL --retry 4 \
      "https://services.gradle.org/distributions/gradle-${REACT_NATIVE_GRADLE_VERSION}-bin.zip" \
      -o /tmp/react-native-gradle.zip \
    && curl -fL --retry 4 \
      "https://services.gradle.org/distributions/gradle-${REACT_NATIVE_GRADLE_VERSION}-bin.zip.sha256" \
      -o /tmp/react-native-gradle.zip.sha256 \
    && printf "%s  %s\n" "$(cat /tmp/react-native-gradle.zip.sha256)" "/tmp/react-native-gradle.zip" | sha256sum -c - \
    && unzip -q /tmp/react-native-gradle.zip -d /opt/gradle \
    && rm /tmp/react-native-gradle.zip /tmp/react-native-gradle.zip.sha256

# Node 22 image already ships Corepack shims.
# Activate pinned Yarn classic and pnpm without overwriting existing /usr/local/bin shims.
RUN corepack enable \
    && corepack prepare yarn@1.22.22 --activate \
    && corepack prepare pnpm@10.17.1 --activate \
    && test "$(yarn --version)" = "1.22.22" \
    && test "$(pnpm --version)" = "10.17.1"


# Fixed AppForge source-build DEBUG signing key.
# This key contains no production secret and is used only for test/installable builds.
RUN keytool -genkeypair \
      -keystore /opt/appforge-source-debug.keystore \
      -storepass android \
      -alias androiddebugkey \
      -keypass android \
      -dname "CN=Android Debug,O=Android,C=US" \
      -keyalg RSA \
      -keysize 2048 \
      -validity 10000 \
    && keytool -list \
      -keystore /opt/appforge-source-debug.keystore \
      -storepass android \
      -alias androiddebugkey >/dev/null

# =========================================================
# .NET MAUI Android toolchain
#
# .NET 10 SDK is copied from Microsoft's pinned SDK image.
# Linux MAUI Android support is installed through the official
# maui-android workload.
# =========================================================
RUN dotnet --info \
    && dotnet workload install maui-android \
    && dotnet workload list | grep -F "maui-android"

# =========================================================
# Flutter Android toolchain
#
# Pinned official stable Linux archive + SHA-256 verification.
# The SDK is installed once in the Worker image.
# =========================================================
RUN curl -fL --retry 4 \
      "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" \
      -o /tmp/flutter.tar.xz \
    && echo "${FLUTTER_SHA256}  /tmp/flutter.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/flutter.tar.xz -C /opt \
    && rm /tmp/flutter.tar.xz \
    && git config --global --add safe.directory /opt/flutter \
    && flutter config --no-analytics \
    && flutter --version \
    && dart --version \
    && flutter precache --android

WORKDIR /app

COPY package*.json ./
RUN npm install --omit=dev

COPY . .

# Worker image'e geçmeden önce regression testleri çalıştır.
# Media3 / Native Bridge gibi kritik generated-code kontratları
# bozulursa pahalı Android/Gradle aşamalarına geçmeden fail olur.
RUN node --test tests/media3_regression.test.js
RUN node --test tests/node_web_build_engine.test.js
RUN node --test tests/python_android_template.test.js
RUN node --test tests/python_source_build_engine.test.js
RUN node --test tests/android_gradle_source_engine.test.js
RUN node --test tests/flutter_build_engine.test.js
RUN node --test tests/flutter_live_build_engine.test.js
RUN node --test tests/react_native_build_engine.test.js
RUN node --test tests/source_build_env.test.js
RUN node --test tests/react_native_live_build_engine.test.js
RUN node --test tests/cpp_android_build_engine.test.js
RUN node --test tests/cpp_android_live_build_engine.test.js
RUN node tests/cpp_android_template_build_smoke.js
RUN node --test tests/dotnet_maui_build_engine.test.js
RUN node --test tests/dotnet_maui_live_build_engine.test.js
RUN node tests/dotnet_maui_android_smoke.js
RUN node --test tests/unity_android_build_engine.test.js
RUN node --test tests/unity_worker_contract.test.js
RUN node --test tests/unity_licensed_build_engine.test.js
RUN node --test tests/framework_static_build_engine.test.js
RUN node --test tests/framework_static_live_build_engine.test.js
RUN node --test tests/python_web_framework_engine.test.js
RUN node --test tests/python_web_framework_live_build_engine.test.js
RUN node tests/python_web_android_smoke.js
RUN node --test tests/php_remote_backend_engine.test.js
RUN node --test tests/php_remote_backend_live_engine.test.js
RUN node --test tests/dotnet_android_build_engine.test.js
RUN node --test tests/dotnet_android_live_build_engine.test.js
RUN node tests/dotnet_android_smoke.js
RUN node --test tests/node_remote_backend_engine.test.js
RUN node --test tests/node_remote_backend_live_engine.test.js
RUN node --test tests/technology_support_matrix.test.js
RUN node --test tests/source_build_isolation.test.js
RUN node --test tests/source_worker_contract.test.js

# =========================================================
# AppForge FAST EXTENDED SDK bundle
#
# QR Scanner
# AdMob
# UMP
# Google Play Billing
# Firebase Analytics
# Firebase Crashlytics
#
# Bu bağımlılıklar Worker image oluşturulurken yalnızca
# bir kez çözülür. Kullanıcı build'lerinde tekrar
# internetten indirilmez.
# =========================================================

RUN gradle     -p fast-sdk-bundle     --no-daemon     --stacktrace     prepareFastSdk prepareFastQrSdk

# =========================================================
# AppForge FAST QR feature pack
#
# QR SDK + bağımlılıkları Worker image oluşturulurken
# DEX'e çevrilir. Kullanıcı build'inde D8 çalışmaz.
# =========================================================

RUN bash scripts/build-fast-qr-pack.sh


# =========================================================
# AppForge FAST EXTENDED template
#
# Native Bridge
# QR Scanner
# AdMob / UMP
# Google Play Billing
# Firebase Analytics / Crashlytics
#
# Gradle burada yalnız Worker image oluşturulurken çalışır.
# Kullanıcının APK build'i sırasında tekrar çalıştırılmaz.
# =========================================================

RUN gradle \
    -p fast-extended-template \
    --no-daemon \
    --stacktrace \
    :app:dependencies \
    --configuration releaseRuntimeClasspath \
    && mkdir -p /opt/appforge-fast-extended \
    && printf "ready\n" > /opt/appforge-fast-extended/cache-ready \
    && test -s /opt/appforge-fast-extended/cache-ready

# AppForge FAST BUILD runtime.
# Bu kod Worker image oluşturulurken yalnızca bir kez DEX'e çevrilir.
# Kullanıcı APK build'lerinde D8/Gradle tekrar çalıştırılmaz.
RUN rm -rf /tmp/appforge-fast-classes \
    && mkdir -p /tmp/appforge-fast-classes /opt/appforge-fast-runtime \
    && javac \
       -encoding UTF-8 \
       -source 17 \
       -target 17 \
       -classpath "$ANDROID_HOME/platforms/android-37.0/android.jar" \
       -d /tmp/appforge-fast-classes \
       fast-runtime/FastActivity.java \
    && "$ANDROID_HOME/build-tools/36.0.0/d8" \
       --release \
       --min-api 26 \
       --output /opt/appforge-fast-runtime \
       $(find /tmp/appforge-fast-classes -type f -name '*.class') \
    && test -s /opt/appforge-fast-runtime/classes.dex \
    && keytool \
       -genkeypair \
       -keystore /opt/appforge-fast-runtime/debug.keystore \
       -storepass android \
       -keypass android \
       -alias androiddebugkey \
       -keyalg RSA \
       -keysize 2048 \
       -validity 10000 \
       -dname "CN=Android Debug,O=Android,C=US" \
       -noprompt \
    && rm -rf /tmp/appforge-fast-classes

# =========================================================
# AppForge Python / Chaquopy runtime template
#
# Worker image oluşturulurken gerçek bir debug APK derlenir.
# Böylece Chaquopy + AGP + Python uyumluluğu deploy sırasında
# doğrulanır ve Maven/Chaquopy bağımlılıkları önceden ısınır.
# =========================================================
RUN python3 --version \
    && gradle \
       -p python-android-template \
       --no-daemon \
       --stacktrace \
       :app:assembleDebug \
    && test -s python-android-template/app/build/outputs/apk/debug/app-debug.apk

RUN node scripts/toolchain-doctor.js --json --strict

HEALTHCHECK --interval=30s --timeout=15s --start-period=20s --retries=3 \
  CMD node scripts/toolchain-doctor.js --strict

# Normal Worker CMD intentionally omitted in dedicated source image.

# =========================================================
# Dedicated AppForge source-build Worker hardening layer
# =========================================================

USER root

RUN groupadd --gid 10001 appforge \
    && useradd \
       --uid 10001 \
       --gid 10001 \
       --create-home \
       --home-dir /home/appforge \
       --shell /usr/sbin/nologin \
       appforge \
    && mkdir -p \
       /app/work \
       /app/outputs \
       /app/shared-inputs \
       /app/gradle-cache \
       /home/appforge/.cache \
    && chown -R \
       10001:10001 \
       /app/work \
       /app/outputs \
       /app/shared-inputs \
       /app/gradle-cache \
       /home/appforge \
    && chmod 0750 \
       /app/work \
       /app/outputs \
       /app/shared-inputs \
       /app/gradle-cache \
    && git config --system --add safe.directory /opt/flutter

ENV HOME=/home/appforge
ENV GRADLE_USER_HOME=/app/gradle-cache

ENV SOURCE_BUILD_ISOLATION_MODE=dedicated
ENV SOURCE_BUILD_REQUIRE_ISOLATION=true
ENV SOURCE_BUILD_ISOLATION_CAPABILITY=source-isolation-dedicated

# Keep the default toolchain capabilities and explicitly attest that
# this deployment is intended to be the isolated source-build worker.
ENV WORKER_CAPABILITIES=android-api-37,build-tools-36.0.0,java-17,gradle,source-isolation-dedicated

USER 10001:10001

CMD ["npm", "run", "worker:source"]
