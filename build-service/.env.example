PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
NODE_ENV=development

DATABASE_URL=postgresql://appforge:change_me@localhost:5432/appforge
PG_SSL=false
PG_POOL_MAX=10

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
REGISTRATION_ENABLED=true
REQUIRE_VERIFIED_EMAIL_FOR_BUILD=false

TOTP_ENCRYPTION_KEY=replace-with-another-long-random-secret

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=AppForge <no-reply@example.com>

GRADLE_BIN=gradle
GRADLE_CACHE_ROOT=./gradle-cache
WORK_ROOT=./work
OUTPUT_ROOT=./outputs
SHARED_INPUT_ROOT=./shared-inputs

RUN_INLINE_WORKER=true
WORKER_ID=worker-main
WORKER_STRICT_TOOLCHAIN=true
EXPECTED_ANDROID_API=37
EXPECTED_BUILD_TOOLS=36.0.0
EXPECTED_GRADLE=9.3.1
EXPECTED_JDK_MAJOR=17
WORKER_CAPABILITIES=android-api-37,build-tools-36.0.0,java-17,gradle
WORKER_POLL_MS=1200
WORKER_HEARTBEAT_MS=5000
WORKER_STALE_AFTER_MS=60000
BUILD_CONCURRENCY=2

# Dedicated licensed Unity Worker
# Keep false on the normal Railway/Android worker.
UNITY_BUILD_ENABLED=false
UNITY_EDITOR_PATH=
UNITY_EDITOR_VERSION=
UNITY_ANDROID_MODULE_PATH=
UNITY_WORKER_HOME=./unity-worker-home
UNITY_BUILD_TIMEOUT_MS=3600000
MAX_QUEUE_SIZE=100
MAX_JOB_ATTEMPTS=2

BUILD_CACHE_ENABLED=true
BUILD_CACHE_TTL_HOURS=24

RATE_LIMIT_PER_HOUR=30
OUTPUT_RETENTION_HOURS=72

STORAGE_DRIVER=local

S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=/secure/google-play-service-account.json


# Live operations
LIVE_LOG_POLL_MS=750
LIVE_LOG_MAX_MINUTES=30
IDEMPOTENCY_TTL_HOURS=24
DOWNLOAD_TICKET_MINUTES=5


# Secure Google Play purchase verifier
PLAY_VERIFIER_ENABLED=false
PLAY_ALLOWED_PACKAGES=com.example.app
PLAY_INAPP_PRODUCTS=premium_unlock,remove_ads,coins_100
PLAY_CONSUMABLE_PRODUCTS=coins_100
PLAY_SUBSCRIPTION_PRODUCTS=premium_monthly,premium_yearly
PLAY_VERIFY_RATE_PER_HOUR=300


# AppForge Studio anti-mod / server-authoritative Pro
STUDIO_ANDROID_PACKAGE=com.appforge.studio
STUDIO_RELEASE_CERT_SHA256=
STUDIO_PRO_PRODUCT_ID=appforge_pro_lifetime
STUDIO_PRO_MONTHLY_PRODUCT_ID=appforge_pro_monthly
PLAY_INTEGRITY_ENABLED=false
PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=0
PRO_REQUIRE_INTEGRITY=true

# The same Google service-account JSON file may be used only if it has
# the necessary Play Integrity / Android Publisher permissions.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=/run/secrets/google-play-service-account.json


# Lifetime free-trial project slots
# Deleting a project does NOT restore a slot.
FREE_PROJECT_LIMIT=5
