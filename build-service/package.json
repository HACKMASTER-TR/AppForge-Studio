{
  "name": "appforge-build-service",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --import ./instrument.mjs server.js",
    "worker": "node --import ./instrument.mjs worker.js",
    "test": "node --test tests/*.test.js",
    "doctor": "node scripts/toolchain-doctor.js",
    "doctor:strict": "node scripts/toolchain-doctor.js --strict",
    "worker:unity": "node --import ./instrument.mjs unity-worker.js",
    "worker:source": "node --import ./instrument.mjs source-worker.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@aws-sdk/s3-request-presigner": "^3.1115.0",
    "@sentry/node": "10.71.0",
    "adm-zip": "0.6.0",
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "googleapis": "^176.0.0",
    "jsonwebtoken": "^9.0.2",
    "monaco-editor": "^0.52.2",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.5",
    "otplib": "^13.4.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "redis": "6.2.1",
    "uuid": "^11.1.0"
  },
  "overrides": {
    "googleapis-common": {
      "gaxios": "7.3.1"
    }
  }
}
