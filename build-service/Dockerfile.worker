FROM node:22-bookworm-slim

ARG ANDROID_CMDLINE_TOOLS_VERSION=15859902
ARG ANDROID_CMDLINE_TOOLS_SHA256=4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583
ARG ANDROID_SDK_LICENSE_ACCEPTED=false
ARG GRADLE_VERSION=9.3.1

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV ANDROID_HOME=/opt/android-sdk
ENV GRADLE_HOME=/opt/gradle/gradle-9.3.1
ENV PATH=/opt/gradle/gradle-9.3.1/bin:/opt/android-sdk/platform-tools:/opt/android-sdk/cmdline-tools/latest/bin:$PATH
ENV NODE_ENV=production

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       curl \
       unzip \
       openjdk-17-jdk-headless \
    && rm -rf /var/lib/apt/lists/*

# Android command-line tools: pin file + verify SHA-256 from Android Developers.
RUN mkdir -p /opt/android-sdk/cmdline-tools \
    && curl -fL --retry 4 \
       "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS_VERSION}_latest.zip" \
       -o /tmp/android-commandline-tools.zip \
    && echo "${ANDROID_CMDLINE_TOOLS_SHA256}  /tmp/android-commandline-tools.zip" | sha256sum -c - \
    && mkdir -p /tmp/android-tools \
    && unzip -q /tmp/android-commandline-tools.zip -d /tmp/android-tools \
    && mkdir -p /opt/android-sdk/cmdline-tools/latest \
    && mv /tmp/android-tools/cmdline-tools/* /opt/android-sdk/cmdline-tools/latest/ \
    && rm -rf /tmp/android-tools /tmp/android-commandline-tools.zip

# SDK license acceptance is intentionally explicit.
# Build with:
#   ANDROID_SDK_LICENSE_ACCEPTED=true docker compose build worker
RUN if [ "${ANDROID_SDK_LICENSE_ACCEPTED}" != "true" ]; then \
      echo "ERROR: Android SDK lisansını kabul ettiysen ANDROID_SDK_LICENSE_ACCEPTED=true ile worker imajını oluştur."; \
      exit 42; \
    fi \
    && yes | sdkmanager --licenses >/dev/null \
    && sdkmanager --channel=3 \
       "platform-tools" \
       "platforms;android-37.0" \
       "build-tools;36.0.0"

# AGP 9.1 requires Gradle 9.3.1 minimum. Verify Gradle's published checksum.
RUN curl -fL --retry 4 \
      "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" \
      -o /tmp/gradle.zip \
    && curl -fL --retry 4 \
      "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip.sha256" \
      -o /tmp/gradle.zip.sha256 \
    && printf "%s  %s\n" "$(cat /tmp/gradle.zip.sha256)" "/tmp/gradle.zip" | sha256sum -c - \
    && mkdir -p /opt/gradle \
    && unzip -q /tmp/gradle.zip -d /opt/gradle \
    && rm /tmp/gradle.zip /tmp/gradle.zip.sha256

WORKDIR /app

COPY package*.json ./
RUN npm install --omit=dev

COPY . .

# Worker image'e geçmeden önce regression testleri çalıştır.
# Media3 / Native Bridge gibi kritik generated-code kontratları
# bozulursa pahalı Android/Gradle aşamalarına geçmeden fail olur.
RUN npm test

# =========================================================
# AppForge FAST EXTENDED SDK bundle
#
# QR Scanner
# AdMob
# UMP
# Google Play Billing
# Firebase Analytics
# Firebase Crashlytics
#
# Bu bağımlılıklar Worker image oluşturulurken yalnızca
# bir kez çözülür. Kullanıcı build'lerinde tekrar
# internetten indirilmez.
# =========================================================

RUN gradle     -p fast-sdk-bundle     --no-daemon     --stacktrace     prepareFastSdk prepareFastQrSdk

# =========================================================
# AppForge FAST QR feature pack
#
# QR SDK + bağımlılıkları Worker image oluşturulurken
# DEX'e çevrilir. Kullanıcı build'inde D8 çalışmaz.
# =========================================================

RUN bash scripts/build-fast-qr-pack.sh


# =========================================================
# AppForge FAST EXTENDED template
#
# Native Bridge
# QR Scanner
# AdMob / UMP
# Google Play Billing
# Firebase Analytics / Crashlytics
#
# Gradle burada yalnız Worker image oluşturulurken çalışır.
# Kullanıcının APK build'i sırasında tekrar çalıştırılmaz.
# =========================================================

RUN gradle \
    -p fast-extended-template \
    --no-daemon \
    --stacktrace \
    :app:dependencies \
    --configuration releaseRuntimeClasspath \
    && mkdir -p /opt/appforge-fast-extended \
    && printf "ready\n" > /opt/appforge-fast-extended/cache-ready \
    && test -s /opt/appforge-fast-extended/cache-ready

# AppForge FAST BUILD runtime.
# Bu kod Worker image oluşturulurken yalnızca bir kez DEX'e çevrilir.
# Kullanıcı APK build'lerinde D8/Gradle tekrar çalıştırılmaz.
RUN rm -rf /tmp/appforge-fast-classes \
    && mkdir -p /tmp/appforge-fast-classes /opt/appforge-fast-runtime \
    && javac \
       -encoding UTF-8 \
       -source 17 \
       -target 17 \
       -classpath "$ANDROID_HOME/platforms/android-37.0/android.jar" \
       -d /tmp/appforge-fast-classes \
       fast-runtime/FastActivity.java \
    && "$ANDROID_HOME/build-tools/36.0.0/d8" \
       --release \
       --min-api 26 \
       --output /opt/appforge-fast-runtime \
       $(find /tmp/appforge-fast-classes -type f -name '*.class') \
    && test -s /opt/appforge-fast-runtime/classes.dex \
    && keytool \
       -genkeypair \
       -keystore /opt/appforge-fast-runtime/debug.keystore \
       -storepass android \
       -keypass android \
       -alias androiddebugkey \
       -keyalg RSA \
       -keysize 2048 \
       -validity 10000 \
       -dname "CN=Android Debug,O=Android,C=US" \
       -noprompt \
    && rm -rf /tmp/appforge-fast-classes

RUN node scripts/toolchain-doctor.js --json --strict

HEALTHCHECK --interval=30s --timeout=15s --start-period=20s --retries=3 \
  CMD node scripts/toolchain-doctor.js --strict

CMD ["npm", "run", "worker"]
