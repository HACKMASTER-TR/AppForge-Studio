FROM node:22-bookworm-slim

ARG ANDROID_CMDLINE_TOOLS_VERSION=15859902
ARG ANDROID_CMDLINE_TOOLS_SHA256=4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583
ARG ANDROID_SDK_LICENSE_ACCEPTED=false
ARG GRADLE_VERSION=9.3.1

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV ANDROID_HOME=/opt/android-sdk
ENV GRADLE_HOME=/opt/gradle/gradle-9.3.1
ENV PATH=/opt/gradle/gradle-9.3.1/bin:/opt/android-sdk/platform-tools:/opt/android-sdk/cmdline-tools/latest/bin:$PATH
ENV NODE_ENV=production

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       curl \
       unzip \
       openjdk-17-jdk-headless \
    && rm -rf /var/lib/apt/lists/*

# Android command-line tools: pin file + verify SHA-256 from Android Developers.
RUN mkdir -p /opt/android-sdk/cmdline-tools \
    && curl -fL --retry 4 \
       "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS_VERSION}_latest.zip" \
       -o /tmp/android-commandline-tools.zip \
    && echo "${ANDROID_CMDLINE_TOOLS_SHA256}  /tmp/android-commandline-tools.zip" | sha256sum -c - \
    && mkdir -p /tmp/android-tools \
    && unzip -q /tmp/android-commandline-tools.zip -d /tmp/android-tools \
    && mkdir -p /opt/android-sdk/cmdline-tools/latest \
    && mv /tmp/android-tools/cmdline-tools/* /opt/android-sdk/cmdline-tools/latest/ \
    && rm -rf /tmp/android-tools /tmp/android-commandline-tools.zip

# SDK license acceptance is intentionally explicit.
# Build with:
#   ANDROID_SDK_LICENSE_ACCEPTED=true docker compose build worker
RUN if [ "${ANDROID_SDK_LICENSE_ACCEPTED}" != "true" ]; then \
      echo "ERROR: Android SDK lisansını kabul ettiysen ANDROID_SDK_LICENSE_ACCEPTED=true ile worker imajını oluştur."; \
      exit 42; \
    fi \
    && yes | sdkmanager --licenses >/dev/null \
    && sdkmanager --channel=3 \
       "platform-tools" \
       "platforms;android-37.0" \
       "build-tools;36.0.0"

# AGP 9.1 requires Gradle 9.3.1 minimum. Verify Gradle's published checksum.
RUN curl -fL --retry 4 \
      "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" \
      -o /tmp/gradle.zip \
    && curl -fL --retry 4 \
      "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip.sha256" \
      -o /tmp/gradle.zip.sha256 \
    && printf "%s  %s\n" "$(cat /tmp/gradle.zip.sha256)" "/tmp/gradle.zip" | sha256sum -c - \
    && mkdir -p /opt/gradle \
    && unzip -q /tmp/gradle.zip -d /opt/gradle \
    && rm /tmp/gradle.zip /tmp/gradle.zip.sha256

WORKDIR /app

COPY package*.json ./
RUN npm install --omit=dev

COPY . .

RUN node scripts/toolchain-doctor.js --json --strict

HEALTHCHECK --interval=30s --timeout=15s --start-period=20s --retries=3 \
  CMD node scripts/toolchain-doctor.js --strict

CMD ["npm", "run", "worker"]
