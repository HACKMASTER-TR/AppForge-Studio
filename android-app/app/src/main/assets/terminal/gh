#!/bin/sh
set -eu

REAL_GH="/usr/bin/gh"
CREDENTIAL="/run/appforge/github-credential"

if [ ! -x "$REAL_GH" ]; then
    echo "AppForge: GitHub CLI bulunamadı: $REAL_GH" >&2
    exit 127
fi

# Explicit user-supplied GH/GITHUB token always wins.
if [ -n "${GH_TOKEN:-}" ] || [ -n "${GITHUB_TOKEN:-}" ]; then
    exec "$REAL_GH" "$@"
fi

# AppForge GitHub connection is mounted into the Linux runtime as:
#   line 1 = username
#   line 2 = access token
#
# Never print or persist the token. It exists only in this gh subprocess.
if [ -r "$CREDENTIAL" ] && [ -s "$CREDENTIAL" ]; then
    token="$(sed -n '2p' "$CREDENTIAL")"

    if [ -n "$token" ]; then
        GH_TOKEN="$token"
        export GH_TOKEN

        unset token

        exec "$REAL_GH" "$@"
    fi
fi

# No AppForge GitHub connection: preserve normal GitHub CLI behavior.
exec "$REAL_GH" "$@"
