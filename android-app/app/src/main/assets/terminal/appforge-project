#!/bin/sh
set -eu

repo="/root/AppForge-Studio"
url="https://github.com/HACKMASTER-TR/AppForge-Studio.git"

valid_repo() {
    git -C "$repo" \
        rev-parse \
        --is-inside-work-tree \
        >/dev/null 2>&1
}

if [ -e "$repo" ] && ! valid_repo; then
    backup="${repo}.partial.$(date +%s)"

    printf '%s\n' \
        "Yarım kalmış native repo bulundu."

    printf 'Yedekleniyor: %s\n' \
        "$backup"

    mv \
        "$repo" \
        "$backup"
fi

if ! valid_repo; then
    printf '%s\n' \
        "AppForge Studio native Linux deposu indiriliyor…"

    git clone \
        "$url" \
        "$repo"
fi

cd "$repo"

printf '%s\n' \
    "=== APPFORGE PROJECT READY ==="

printf 'Repo:   %s\n' \
    "$(git rev-parse --show-toplevel)"

printf 'Branch: %s\n' \
    "$(git branch --show-current)"

printf 'HEAD:   %s\n' \
    "$(git log -1 --oneline)"

printf '\n%s\n' \
    "Git/NPM geliştirme alanı: /root/AppForge-Studio"

printf '%s\n' \
    "Android Files paylaşım alanı: /workspace"

printf '\n%s\n' \
    "Bu shell artık AppForge-Studio deposunda."

exec /bin/bash
