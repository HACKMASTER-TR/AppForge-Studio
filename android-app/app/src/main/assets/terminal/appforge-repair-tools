#!/bin/sh
set -eu

printf '%s\n' \
    "=== APPFORGE TOOLCHAIN REPAIR ==="

printf '%s\n' \
    "Yarım kalan dpkg işlemleri kontrol ediliyor…"

DEBIAN_FRONTEND=noninteractive \
dpkg --configure -a

DEBIAN_FRONTEND=noninteractive \
apt-get -f install -y

apt-get update

# NodeSource kurulumu için gereken minimum araçlar.
DEBIAN_FRONTEND=noninteractive \
apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg

node_major="$(
    node -p \
        'process.versions.node.split(".")[0]' \
        2>/dev/null ||
        printf '0'
)"

if [ "$node_major" != "22" ]; then
    printf '\n%s\n' \
        "Node.js 22 CI sürümü hazırlanıyor…"

    setup_file="/tmp/appforge-nodesource-22.sh"

    curl -fsSL \
        https://deb.nodesource.com/setup_22.x \
        -o "$setup_file"

    bash "$setup_file"

    rm -f "$setup_file"

    DEBIAN_FRONTEND=noninteractive \
    apt-get install -y \
        --allow-downgrades \
        nodejs

    hash -r
fi

DEBIAN_FRONTEND=noninteractive \
apt-get install -y --no-install-recommends \
    git \
    openssh-client \
    wget \
    rsync \
    zip \
    unzip \
    xz-utils \
    bzip2 \
    gzip \
    tar \
    jq \
    sqlite3 \
    openssl \
    bash \
    zsh \
    less \
    nano \
    file \
    procps \
    python3 \
    python3-pip \
    python3-venv \
    python-is-python3 \
    pipx \
    default-jdk \
    maven \
    gradle \
    build-essential \
    clang \
    lld \
    cmake \
    ninja-build \
    pkg-config \
    gdb

printf '\n%s\n' \
    "=== RESULT ==="

for c in \
    git \
    ssh \
    curl \
    wget \
    python3 \
    node \
    npm \
    java \
    gradle \
    clang \
    cmake \
    jq \
    nano
do
    if command -v "$c" >/dev/null 2>&1; then
        printf '%-18s PASS\n' "$c"
    else
        printf '%-18s MISS\n' "$c"
        exit 1
    fi
done

node_major="$(
    node -p \
        'process.versions.node.split(".")[0]'
)"

if [ "$node_major" = "22" ]; then
    printf '%-18s PASS\n' \
        "node-ci-22"
else
    printf '%-18s MISS\n' \
        "node-ci-22"

    printf 'Node: %s\n' \
        "$(node --version)"

    exit 1
fi

printf 'node-version       %s\n' \
    "$(node --version)"

printf 'npm-version        %s\n' \
    "$(npm --version)"

printf '%s\n' \
    "APPFORGE CORE TOOLCHAIN READY"
