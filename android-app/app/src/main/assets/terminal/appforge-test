#!/bin/sh
set -eu

native_repo="/root/AppForge-Studio"

repo_root="$(
    git rev-parse \
        --show-toplevel \
        2>/dev/null ||
        true
)"

if [ -z "$repo_root" ] &&
   [ -d "$native_repo/.git" ]; then
    repo_root="$native_repo"
fi

if [ -n "$repo_root" ] &&
   [ -f "$repo_root/build-service/package.json" ]; then
    cd "$repo_root/build-service"
elif [ -n "$repo_root" ] &&
     [ -f "$repo_root/package.json" ]; then
    cd "$repo_root"
elif [ -f /workspace/build-service/package.json ]; then
    cd /workspace/build-service
elif [ -f /workspace/package.json ]; then
    cd /workspace
else
    printf '%s\n' \
        "package.json veya build-service/package.json bulunamadı." >&2
    exit 2
fi

node_major="$(
    node -p \
        'process.versions.node.split(".")[0]' \
        2>/dev/null ||
        printf '0'
)"

if [ "$node_major" != "22" ]; then
    printf '%s\n' \
        "AppForge testleri Node.js 22 gerektiriyor." >&2

    printf '%s\n' \
        "Önce appforge-repair-tools çalıştır." >&2

    exit 3
fi

if [ -f package-lock.json ]; then
    dependency_refresh=0

    if [ ! -d node_modules ]; then
        dependency_refresh=1
    elif [ ! -f node_modules/.package-lock.json ]; then
        dependency_refresh=1
    elif [ package-lock.json -nt node_modules/.package-lock.json ]; then
        dependency_refresh=1
    fi

    if [ "$dependency_refresh" -eq 1 ]; then
        printf '%s\n' \
            "Node bağımlılıkları hazırlanıyor…"

        npm ci \
            --no-audit \
            --no-fund
    fi
fi

if [ "$#" -eq 0 ]; then
    exec npm test
fi

exec npm test -- "$@"
