#!/bin/sh
set -u

failed=0
tool_failed=0
native_repo="/root/AppForge-Studio"

pass_item() {
    printf '%-22s PASS\n' "$1"
}

miss_item() {
    printf '%-22s MISS\n' "$1"
    failed=1
}

printf '%s\n' \
    "=== APPFORGE STANDALONE DOCTOR ==="

for command_name in \
    sh \
    bash \
    git \
    ssh \
    curl \
    wget \
    python3 \
    node \
    npm \
    java \
    gradle \
    clang \
    cmake \
    jq \
    nano
do
    if command -v "$command_name" >/dev/null 2>&1; then
        pass_item "$command_name"
    else
        miss_item "$command_name"
        tool_failed=1
    fi
done

node_major="$(
    node -p \
        'process.versions.node.split(".")[0]' \
        2>/dev/null ||
        printf '0'
)"

if [ "$node_major" = "22" ]; then
    pass_item "node-ci-22"
else
    miss_item "node-ci-22"
    tool_failed=1

    printf '%s\n' \
        "AppForge CI ile aynı ortam için Node.js 22 gerekli."
fi

if [ "$tool_failed" -ne 0 ]; then
    printf '\n%s\n' \
        "Eksik/uyumsuz araçları düzeltmek için: appforge-repair-tools"
fi

if [ -d /workspace ] &&
   [ -r /workspace ] &&
   [ -w /workspace ]; then
    pass_item "/workspace"
else
    miss_item "/workspace"
fi

if [ -x /usr/local/bin/appforge-git-askpass ] &&
   [ -s /run/appforge/github-credential ]; then
    pass_item "github-auth-bridge"
else
    miss_item "github-auth-bridge"

    printf '%s\n' \
        "GitHub için: Bağlantılar > GitHub hesabını bağla, ardından terminal oturumunu yeniden başlat."
fi

repo_root="$(
    git rev-parse \
        --show-toplevel \
        2>/dev/null ||
        true
)"

if [ -z "$repo_root" ] &&
   git -C "$native_repo" \
       rev-parse \
       --is-inside-work-tree \
       >/dev/null 2>&1; then
    repo_root="$native_repo"
fi

if [ -n "$repo_root" ]; then
    pass_item "git-repository"

    printf 'repo                   %s\n' \
        "$repo_root"

    printf 'branch                 %s\n' \
        "$(
            git -C "$repo_root" \
                branch \
                --show-current \
                2>/dev/null ||
                printf 'HEAD'
        )"
else
    printf '%-22s INFO\n' \
        "git-repository"

    printf '%s\n' \
        "AppForge repo için: appforge-project"
fi

printf '%s\n' \
    "=================================="

exit "$failed"
