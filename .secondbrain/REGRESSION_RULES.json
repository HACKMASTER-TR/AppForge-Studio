{
  "version": 2,
  "policy": "HARD_STABILITY_GATE_V1",
  "hard_gate": true,
  "fail_on_regression": true,
  "main_is_stable_only": true,
  "require_diff_check": true,
  "require_secondbrain_selftest": true,
  "require_regression_validation": true,
  "compile_success_is_not_runtime_proof": true,
  "exact_sha_artifacts": true,
  "forbidden_staged_patterns": [
    "*.apk",
    "*.aab",
    "*.save",
    "*.bak",
    "dashboard.sh",
    "dashboard.sh.bak"
  ],
  "protected_features": [
    {
      "name": "Terminal",
      "keywords": [
        "terminal",
        "pty",
        "ime",
        "keyboard",
        "paste",
        "shortcut",
        "scroll"
      ]
    },
    {
      "name": "Files",
      "keywords": [
        "file",
        "workspace",
        "storage",
        "download"
      ]
    },
    {
      "name": "Git",
      "keywords": [
        "git",
        "github"
      ]
    },
    {
      "name": "Connections",
      "keywords": [
        "connection",
        "oauth",
        "railway",
        "authorization"
      ]
    },
    {
      "name": "SSH",
      "keywords": [
        "ssh",
        "hostkey"
      ]
    },
    {
      "name": "Tools",
      "keywords": [
        "toolchain",
        "tools",
        "runtime"
      ]
    },
    {
      "name": "Builder",
      "keywords": [
        "builder",
        "build",
        "gradle",
        "apk",
        "aab"
      ]
    },
    {
      "name": "AI",
      "keywords": [
        "assistant",
        "ai",
        "litert",
        "secondbrain"
      ]
    },
    {
      "name": "Auth",
      "keywords": [
        "auth",
        "login",
        "account",
        "token"
      ]
    },
    {
      "name": "OwnerIsolation",
      "keywords": [
        "owner",
        "isolation",
        "account"
      ]
    },
    {
      "name": "FreePro",
      "keywords": [
        "free",
        "pro",
        "entitlement",
        "subscription"
      ]
    },
    {
      "name": "BillingQuota",
      "keywords": [
        "billing",
        "purchase",
        "quota",
        "play"
      ]
    },
    {
      "name": "BuildService",
      "keywords": [
        "build-service",
        "api",
        "server"
      ]
    },
    {
      "name": "Database",
      "keywords": [
        "sql",
        "database",
        "postgres",
        "migration"
      ]
    },
    {
      "name": "Workers",
      "keywords": [
        "worker",
        "queue",
        "job"
      ]
    },
    {
      "name": "RailwayRender",
      "keywords": [
        "railway",
        "render",
        "deploy"
      ]
    },
    {
      "name": "Web",
      "keywords": [
        "web",
        "pwa",
        "browser"
      ]
    },
    {
      "name": "Desktop",
      "keywords": [
        "desktop",
        "windows",
        "electron",
        "exe"
      ]
    },
    {
      "name": "ExcelTools",
      "keywords": [
        "excel",
        "xlsx",
        "spreadsheet"
      ]
    },
    {
      "name": "VideoForge",
      "keywords": [
        "videoforge",
        "video",
