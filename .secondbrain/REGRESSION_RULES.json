      ]
    },
    {
      "name": "Notifications",
      "keywords": [
        "notification",
        "push",
        "fcm"
      ]
    },
    {
      "name": "CIRelease",
      "keywords": [
        "workflow",
        "ci",
        "release",
        "deploy"
      ]
    },
    {
      "name": "Security",
      "keywords": [
        "security",
        "permission",
        "credential",
        "secret"
      ]
    },
    {
      "name": "Performance",
      "keywords": [
        "performance",
        "latency",
        "memory",
        "jank"
      ]
    }
  ],
  "gate_version": 2,
  "require_pull_request_for_main": true,
  "direct_main_push_forbidden": true,
  "all_mandatory_gates_must_pass": true,
  "mandatory_ci_gates": [
    "Second Brain / Policy",
    "Build Service Regression",
    "Android Regression",
    "Static Smoke",
    "AppForge Stability Summary"
  ],
  "domain_gates": {
    "android_terminal": {
      "paths": [
        "android-app/**"
      ],
      "tests": [
        ":app:testDebugUnitTest"
      ],
      "runtime_validation_required": true,
      "ci": "AppForge Android Debug"
    },
    "backend_api_auth_billing": {
      "paths": [
        "build-service/**"
      ],
      "tests": [
        "npm test"
      ]
    },
    "workers_conversion": {
      "paths": [
        "build-service/*worker*",
        "build-service/scripts/*smoke*",
        ".github/workflows/*worker*",
        ".github/workflows/conversion-smoke.yml"
      ],
      "tests": [
        "build-service regression",
        "worker/smoke syntax"
      ]
    },
    "secondbrain": {
      "paths": [
        ".secondbrain/**",
        "SECOND_BRAIN.md",
        "AGENTS.md",
        "scripts/brain",
        "scripts/appforge-stability-gate"
      ],
      "tests": [
        "brain selftest",
        "brain doctor"
      ]
    },
    "ci_release": {
      "paths": [
        ".github/**"
      ],
      "tests": [
        "workflow validation",
        "stability summary"
      ]
    }
  }
}
