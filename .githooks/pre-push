#!/bin/sh
set -eu

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT

cat > "$TMP"

BLOCK=0

while read -r local_ref local_sha remote_ref remote_sha
do
    [ -n "${remote_ref:-}" ] || continue

    if [ "$remote_ref" = "refs/heads/main" ]; then
        echo "BLOCKED: main branch'e doğrudan push yasak."
        echo "Fix/feature branch -> CI -> PR -> merge kullanılmalı."
        BLOCK=1
    fi
done < "$TMP"

if [ "$BLOCK" -ne 0 ]; then
    exit 1
fi

echo "AppForge: pre-push HARD STABILITY GATE"
./scripts/appforge-stability-gate local
