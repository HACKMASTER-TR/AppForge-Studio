#!/usr/bin/env python3

from __future__ import annotations

import json
import re
import sys
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path("/root/AppForge-Studio")
RUNTIME = ROOT / ".appforge-brain/runtime"
LATEST = RUNTIME / "architecture-risk.json"
HISTORY = RUNTIME / "architecture-risk-history.jsonl"

RUNTIME.mkdir(parents=True, exist_ok=True)

DIMENSIONS = {
    "coupling": 2,
    "regression": 2,
    "buildImpact": 1,
    "securityImpact": 1,
    "performanceImpact": 1,
    "dataImpact": 1,
}

RULES = {
    "coupling": {
        2: [
            "mainactivity", "global state", "singleton", "shared state",
            "core", "cross-module", "birçok modül", "tüm modüller",
            "terminal", "builder", "connections", "production center",
            "workspace", "cloud workspace", "çok kullanıcılı",
            "multi-user", "izolasyon", "isolation",
        ],
        1: [
            "viewmodel", "repository", "service", "manager",
            "shared", "ortak", "navigation",
        ],
    },
    "regression": {
        2: [
            "refactor", "rewrite", "yeniden yaz", "terminal",
            "auth", "login", "build-service", "builder",
            "release", "worker", "git", "ssh", "database",
            "workspace", "persistent", "kalıcı", "background build",
            "session", "oturum",
        ],
        1: [
            "mevcut", "değiştir", "replace", "migration",
            "gradle", "compose", "runtime",
        ],
    },
    "buildImpact": {
        2: [
            "gradle", "apk", "aab", "compiler", "build",
            "worker", "docker", "native", "ndk", "cmake",
            "dependency", "plugin", "play store",
        ],
        1: [
            "android", "versioncode", "signing",
            "artifact", "cache", "ci",
        ],
    },
    "securityImpact": {
        2: [
            "token", "credential", "secret", "password",
            "ssh", "authentication", "authorization",
            "permission", "keystore", "api key",
            "oauth", "connector", "multi-user", "çok kullanıcılı",
            "izolasyon", "isolation", "workspace",
        ],
        1: [
            "network", "upload", "download", "cloud",
            "github", "railway", "firebase", "supabase",
            "vercel", "webhook",
        ],
    },
    "performanceImpact": {
        2: [
            "1000", "parallel", "concurrent", "real-time",
            "realtime", "stream", "large file", "20k",
            "terminal", "worker", "build", "video",
            "workspace", "cloud workspace", "background build",
            "persistent", "kalıcı",
        ],
        1: [
            "cache", "background", "sync", "queue",
            "pagination", "memory", "cpu",
        ],
    },
    "dataImpact": {
        2: [
            "migration", "schema", "database", "prisma",
            "postgres", "supabase", "delete data",
            "drop table", "user data",
        ],
        1: [
            "storage", "backup", "restore", "model",
            "json", "project format",
        ],
    },
}

DANGEROUS_PATTERNS = [
    "hardcode secret",
    "hardcode token",
    "disable auth",
    "bypass auth",
    "skip verification",
    "disable verification",
    "plaintext password",
    "plain text password",
    "ignore certificate",
    "disable host key",
]

REFERENCE_HINTS = {
    "VS Code": [
        "mainactivity", "viewmodel", "editor", "terminal",
        "module", "plugin", "extension", "architecture",
    ],
    "Expo EAS": [
        "build", "release", "apk", "aab", "play store",
        "signing", "artifact",
    ],
    "Turborepo": [
        "cache", "build", "dependency", "incremental",
        "worker", "performance",
    ],
    "n8n": [
        "connector", "credential", "github", "railway",
        "firebase", "supabase", "vercel", "oauth",
    ],
    "Coder/code-server": [
        "terminal", "workspace", "cloud", "session",
        "linux", "remote", "container",
    ],
    "Sentry": [
        "production", "crash", "error", "metric",
        "observability", "latency", "release health",
    ],
}


def normalize(text: str) -> str:
    return text.casefold()


def clamp(value: int) -> int:
    return max(0, min(10, value))


def score_feature(description: str) -> dict:
    text = normalize(description)
    scores = dict(DIMENSIONS)
    reasons: dict[str, list[str]] = {key: [] for key in scores}

    for dimension, weights in RULES.items():
        for weight, terms in weights.items():
            hits = []
            for term in terms:
                if normalize(term) in text:
                    hits.append(term)

            if hits:
                scores[dimension] += min(8, len(hits) * weight)
                reasons[dimension].extend(hits[:5])

    # Scope indicators.
    if any(x in text for x in [
        "tüm uygulama", "her yerde", "bütün sistem",
        "all modules", "entire app",
    ]):
        scores["coupling"] += 3
        scores["regression"] += 2
        reasons["coupling"].append("wide-scope change")

    # Numeric scale indicators.
    numbers = [
        int(x)
        for x in re.findall(r"\b\d{3,7}\b", text)
        if x.isdigit()
    ]
    if numbers and max(numbers) >= 1000:
        scores["performanceImpact"] += 2
        reasons["performanceImpact"].append(
            f"scale >= {max(numbers)}"
        )

    scores = {k: clamp(v) for k, v in scores.items()}

    dangerous = [
        p for p in DANGEROUS_PATTERNS
        if normalize(p) in text
    ]

    # Blocking security patterns are always critical risk.
    if dangerous:
        scores["securityImpact"] = 10
        reasons["securityImpact"].extend(
            f"BLOCKING: {item}" for item in dangerous
        )

    weights = {
        "coupling": 0.22,
        "regression": 0.24,
        "buildImpact": 0.15,
        "securityImpact": 0.18,
        "performanceImpact": 0.13,
        "dataImpact": 0.08,
    }

    overall = round(
        sum(scores[k] * weights[k] for k in scores),
        1
    )

    max_score = max(scores.values())

    elevated_dimensions = sum(
        1 for value in scores.values()
        if value >= 5
    )

    if dangerous:
        decision = "REJECT"
    elif (
        max_score >= 8
        or overall >= 5.5
        or elevated_dimensions >= 3
        or scores["coupling"] >= 7
        or scores["regression"] >= 7
        or scores["securityImpact"] >= 7
    ):
        decision = "REFACTOR_FIRST"
    else:
        decision = "ACCEPT"

    if overall >= 6.0 or max_score >= 8:
        coverage = "HIGH"
    elif overall >= 4.0:
        coverage = "MEDIUM"
    else:
        coverage = "NORMAL"

    references = ["Renuvex Product Reviews"]

    for ref, terms in REFERENCE_HINTS.items():
        if any(normalize(term) in text for term in terms):
            references.append(ref)

    # Stable order, no duplicates.
    references = list(dict.fromkeys(references))

    gates = []

    if scores["coupling"] >= 7:
        gates.append(
            "Split responsibilities/modules before implementation."
        )

    if scores["regression"] >= 7:
        gates.append(
            "Add regression tests for existing behavior before changing it."
        )

    if scores["buildImpact"] >= 7:
        gates.append(
            "Benchmark build time and preserve cache/reproducibility."
        )

    if scores["securityImpact"] >= 7:
        gates.append(
            "Require explicit permission/credential boundary and security tests."
        )

    if scores["performanceImpact"] >= 7:
        gates.append(
            "Define P50/P95 performance budget and stress test."
        )

    if scores["dataImpact"] >= 7:
        gates.append(
            "Require migration/rollback and backup compatibility plan."
        )

    if not gates:
        gates.append(
            "Implement behind clear module boundaries with automated tests."
        )

    return {
        "schemaVersion": 1,
        "createdAt": datetime.now(timezone.utc).isoformat(),
        "feature": description,
        "scores": scores,
        "overallRisk": overall,
        "decision": decision,
        "testCoverageRequired": coverage,
        "dangerousPatterns": dangerous,
        "reasons": reasons,
        "recommendedReferences": references,
        "requiredGates": gates,
    }


def print_report(result: dict) -> None:
    s = result["scores"]

    print("======================================")
    print(" APPFORGE SECOND BRAIN ARCHITECTURE RISK")
    print("======================================")
    print()
    print("Feature:", result["feature"])
    print()
    print(f"Coupling:           {s['coupling']}/10")
    print(f"Regression Risk:    {s['regression']}/10")
    print(f"Build Impact:       {s['buildImpact']}/10")
    print(f"Security Impact:    {s['securityImpact']}/10")
    print(f"Performance Impact: {s['performanceImpact']}/10")
    print(f"Data Impact:        {s['dataImpact']}/10")
    print()
    print(f"Overall Risk:       {result['overallRisk']}/10")
    print(
        "Test Coverage:     "
        + result["testCoverageRequired"]
    )
    print(
        "Architecture Decision: "
        + result["decision"]
    )
    print()
    print("References:")
    for ref in result["recommendedReferences"]:
        print(" -", ref)

    print()
    print("Required gates:")
    for gate in result["requiredGates"]:
        print(" -", gate)

    if result["dangerousPatterns"]:
        print()
        print("BLOCKING SECURITY PATTERNS:")
        for item in result["dangerousPatterns"]:
            print(" -", item)

    print("======================================")


def save_result(result: dict) -> None:
    LATEST.write_text(
        json.dumps(
            result,
            ensure_ascii=False,
            indent=2,
        ) + "\n",
        encoding="utf-8",
    )

    with HISTORY.open("a", encoding="utf-8") as f:
        f.write(
            json.dumps(
                result,
                ensure_ascii=False,
                separators=(",", ":"),
            ) + "\n"
        )


def self_test() -> int:
    low = score_feature(
        "Settings ekranına bağımsız yardım metni ekle"
    )
    high = score_feature(
        "MainActivity içindeki terminal build auth ve "
        "credential sistemini global state ile birleştir"
    )
    blocked = score_feature(
        "disable auth and hardcode token for connector"
    )

    checks = [
        low["decision"] == "ACCEPT",
        high["decision"] == "REFACTOR_FIRST",
        blocked["decision"] == "REJECT",
        blocked["scores"]["securityImpact"] >= 7,
    ]

    if all(checks):
        print("PASS - brain-risk self-test")
        return 0

    print("FAIL - brain-risk self-test")
    print(
        json.dumps(
            {
                "low": low,
                "high": high,
                "blocked": blocked,
            },
            ensure_ascii=False,
            indent=2,
        )
    )
    return 1


def main() -> int:
    if "--self-test" in sys.argv:
        return self_test()

    args = [
        arg for arg in sys.argv[1:]
        if not arg.startswith("--")
    ]

    if args:
        description = " ".join(args).strip()
    else:
        try:
            description = input(
                "Yeni özellik/değişiklik açıklaması: "
            ).strip()
        except EOFError:
            description = ""

    if not description:
        print("FAIL - feature description required")
        return 2

    result = score_feature(description)
    save_result(result)
    print_report(result)

    # Risk decision is informational.
    # REFACTOR_FIRST/REJECT do not break brain-go by themselves.
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
