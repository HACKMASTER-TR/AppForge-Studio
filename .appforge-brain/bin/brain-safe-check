#!/bin/bash

ROOT="/root/AppForge-Studio"
cd "$ROOT" || exit 1

fail=0
skipped=0

echo "======================================"
echo " APPFORGE SECOND BRAIN SAFE CHECK"
echo "======================================"

echo
echo "=== ENVIRONMENT ==="

ARCH="$(uname -m)"
echo "ARCH: $ARCH"

IS_PROOT=0

if grep -qiE 'proot|PRoot' /proc/1/status 2>/dev/null; then
    IS_PROOT=1
fi

if [ -n "${PROOT_TMP_DIR:-}" ]; then
    IS_PROOT=1
fi

if [ "$IS_PROOT" -eq 1 ]; then
    echo "RUNTIME: PROOT"
else
    echo "RUNTIME: NATIVE/UNKNOWN"
fi


echo
echo "=== SECOND BRAIN ARCHITECTURE MEMORY ==="

REFERENCE_FILE=".appforge-brain/reference-projects.md"

if [ ! -s "$REFERENCE_FILE" ]; then
    echo "FAIL - architecture reference memory missing"
    fail=$((fail+1))
else
    echo "PASS - architecture reference memory loaded"

    for REF in         "Renuvex Product Reviews"         "VS Code"         "Expo EAS"         "Turborepo"         "n8n"         "Coder"         "Sentry"
    do
        if grep -q "$REF" "$REFERENCE_FILE"; then
            echo "PASS - reference: $REF"
        else
            echo "FAIL - missing reference: $REF"
            fail=$((fail+1))
        fi
    done
fi


echo
echo "=== ARCHITECTURE RISK GATE ==="

if [ ! -x .appforge-brain/bin/brain-risk ]; then
    echo "FAIL - brain-risk missing"
    fail=$((fail+1))
else
    .appforge-brain/bin/brain-risk --self-test

    if [ "$?" -ne 0 ]; then
        fail=$((fail+1))
    else
        echo "PASS - Architecture Risk Gate active"
    fi
fi


echo
echo "=== TERMINAL 20K STATIC CHECK ==="

python3 - <<'PY'
from pathlib import Path
import sys

root = Path("/root/AppForge-Studio")

buffer = root / (
    "android-app/app/src/main/java/com/appforge/studio/"
    "terminal/AnsiTerminalBuffer.kt"
)

panel = root / (
    "android-app/app/src/main/java/com/appforge/studio/"
    "terminal/LocalPtyTerminalPanel.kt"
)

test = root / (
    "android-app/app/src/test/java/com/appforge/studio/"
    "terminal/LocalPtyInteractiveInputTest.kt"
)

checks = []

if not buffer.is_file():
    checks.append(("AnsiTerminalBuffer", False))
else:
    text = buffer.read_text(encoding="utf-8")
    checks.append((
        "20K scrollback",
        "maxScrollbackLines: Int = 20_000" in text
    ))

if not panel.is_file():
    checks.append(("LocalPtyTerminalPanel", False))
else:
    text = panel.read_text(encoding="utf-8")

    checks += [
        (
            "PTY chunk helper",
            "localPtyInputWriteChunks(" in text
        ),
        (
            "16K PTY chunks",
            "16_384" in text
        ),
        (
            "Bracketed paste start",
            "LOCAL_PTY_BRACKETED_PASTE_START" in text
        ),
        (
            "Bracketed paste end",
            "LOCAL_PTY_BRACKETED_PASTE_END" in text
        ),
    ]

if not test.is_file():
    checks.append(("LocalPtyInteractiveInputTest", False))
else:
    text = test.read_text(encoding="utf-8")

    checks += [
        (
            "20K paste test",
            "twentyThousandLinePasteIsPreserved" in text
        ),
        (
            "Unicode boundary test",
            "chunkingDoesNotSplitUnicodeSurrogatePairs" in text
        ),
    ]

failed = 0

for name, ok in checks:
    print(
        ("PASS" if ok else "FAIL"),
        "-",
        name
    )

    if not ok:
        failed += 1

if failed:
    sys.exit(1)
PY

if [ "$?" -ne 0 ]; then
    fail=$((fail+1))
fi


echo
echo "=== WHITESPACE AUDIT ==="

python3 - <<'PY'
from pathlib import Path
import sys

paths = [
    Path(
        "android-app/app/src/main/java/com/appforge/studio/"
        "terminal/AnsiTerminalBuffer.kt"
    ),
    Path(
        "android-app/app/src/main/java/com/appforge/studio/"
        "terminal/LocalPtyTerminalPanel.kt"
    ),
    Path(
        "android-app/app/src/test/java/com/appforge/studio/"
        "terminal/LocalPtyInteractiveInputTest.kt"
    ),
]

bad = []

for path in paths:
    if not path.exists():
        continue

    for n, line in enumerate(
        path.read_text(encoding="utf-8").splitlines(),
        1
    ):
        if line.endswith(" ") or line.endswith("\t"):
            bad.append((path, n))

if bad:
    print("FAIL - trailing whitespace")
    for p, n in bad[:20]:
        print(p, n)
    sys.exit(1)

print("PASS - whitespace")
PY

if [ "$?" -ne 0 ]; then
    fail=$((fail+1))
fi


echo
echo "=== NODE TERMINAL REGRESSION ==="

for TEST in \
build-service/tests/terminal_bracketed_paste_mode_contract.test.js \
build-service/tests/appforge_terminal_ime_backspace_contract.test.js
do
    if [ -f "$TEST" ]; then

        node --test "$TEST"

        if [ "$?" -ne 0 ]; then
            fail=$((fail+1))
        fi

    else
        echo "SKIP - $TEST bulunamadi"
        skipped=$((skipped+1))
    fi
done


echo
echo "=== ANDROID BUILD POLICY ==="

ANDROID_SUPPORTED=1

if [ "$ARCH" = "aarch64" ] && [ "$IS_PROOT" -eq 1 ]; then
    ANDROID_SUPPORTED=0
fi

if [ "$ANDROID_SUPPORTED" -eq 0 ]; then

    echo "SKIP - Android local build"
    echo "REASON: aarch64 + PROOT unsupported local Android CI environment"
    echo "STATUS: ENV_UNSUPPORTED_NOT_FAILURE"

    skipped=$((skipped+1))

else

    GRADLE="$HOME/.local/opt/gradle-9.3.1/bin/gradle"

    if [ ! -x "$GRADLE" ]; then

        echo "SKIP - Gradle 9.3.1 yok"
        skipped=$((skipped+1))

    elif [ -z "${ANDROID_HOME:-}" ] && \
         [ -z "${ANDROID_SDK_ROOT:-}" ]; then

        echo "SKIP - Android SDK tanimli degil"
        skipped=$((skipped+1))

    else

        echo "Android build environment supported."

        set +e

        "$GRADLE" \
          -p android-app \
          :app:compileDebugKotlin \
          :app:testDebugUnitTest \
          --no-daemon \
          --console=plain

        rc=$?

        set -e

        if [ "$rc" -ne 0 ]; then
            echo "FAIL - Android source/build regression"
            fail=$((fail+1))
        else
            echo "PASS - Android compile/unit tests"
        fi
    fi
fi


echo
echo "=== PUSH POLICY ==="

if [ -x .githooks/pre-push ]; then

    if .githooks/pre-push origin test >/dev/null 2>&1; then
        echo "PASS - GIT PUSH AUTHORIZED"
    else
        echo "FAIL - push authorization disabled"
        fail=$((fail+1))
    fi

else
    echo "FAIL - pre-push lock missing"
    fail=$((fail+1))
fi


echo
echo "=== SECOND BRAIN RECORD ==="

python3 - "$fail" "$skipped" "$ARCH" "$IS_PROOT" <<'PY'
from pathlib import Path
from datetime import datetime, timezone
import json
import sys

fail = int(sys.argv[1])
skipped = int(sys.argv[2])
arch = sys.argv[3]
proot = bool(int(sys.argv[4]))

p = Path(
    ".appforge-brain/runtime/checkpoint.json"
)

try:
    d = json.loads(
        p.read_text(encoding="utf-8")
    )
except Exception:
    d = {}

d.update({
    "safeWorkflow": True,
    "architectureMemoryFile":
        ".appforge-brain/reference-projects.md",
    "architectureMemoryEnabled":
        True,
    "architectureRiskGateEnabled":
        True,
    "architectureRiskTool":
        ".appforge-brain/bin/brain-risk",
    "architectureRiskDecisions": [
        "ACCEPT",
        "REFACTOR_FIRST",
        "REJECT"
    ],
    "targetArchitecture":
        "Renuvex discipline + VS Code modularity + Expo EAS release workflow + Turborepo caching + n8n connectors + Coder workspaces + Sentry observability",
    "architecturePriorities": [
        "VS Code modular architecture",
        "Expo EAS build and release workflow",
        "Turborepo incremental cache",
        "n8n Connector SDK",
        "Coder persistent cloud workspace",
        "Sentry Release Health"
    ],
    "hostArchitecture": arch,
    "isProot": proot,
    "androidLocalBuildPolicy":
        "skip-on-aarch64-proot",
    "expectedEnvironmentFailuresAreErrors":
        False,
    "lastSafeCheckFailures":
        fail,
    "lastSafeCheckSkipped":
        skipped,
    "pushAllowed":
        False,
    "pushPolicy":
        "authorized",
    "checkpointUpdatedAt":
        datetime.now(timezone.utc).isoformat()
})

if fail == 0:
    d["currentStage"] = (
        "AppForge local validation healthy"
    )
    d["nextAction"] = (
        "Continue development using safe checks. "
        "Do not attempt unsupported Android builds "
        "inside aarch64 PROOT."
    )

p.write_text(
    json.dumps(
        d,
        ensure_ascii=False,
        indent=2
    ) + "\n",
    encoding="utf-8"
)

print("PASS - SecondBrain checkpoint updated")
PY


echo
echo "======================================"
echo "fail $fail"
echo "skipped $skipped"
echo "======================================"

if [ "$fail" -eq 0 ]; then
    echo "SECOND BRAIN SAFE WORKFLOW PASS"
    echo "EXPECTED ENV ERRORS: SUPPRESSED"
    echo "REAL SOURCE ERRORS: STILL DETECTED"
    echo "ANDROID ARM64/PROOT BUILD: AUTO-SKIP"
    echo "TERMINAL 20K: VALIDATED"
    echo "GIT PUSH: AUTHORIZED"
    echo "PUSH YAPILMADI"
else
    echo "REAL FAILURE DETECTED"
fi

exit "$fail"
