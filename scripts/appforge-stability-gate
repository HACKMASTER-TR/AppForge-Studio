#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$ROOT"

MODE="${1:-local}"
FAIL=0

# Portable runtime temp area.
# Android/Termux environments may not provide a writable /tmp.
APPFORGE_TMPDIR="${APPFORGE_TMPDIR:-$ROOT/.appforge/tmp}"

if ! mkdir -p "$APPFORGE_TMPDIR"; then
    echo "FAIL  Cannot create AppForge temp directory: $APPFORGE_TMPDIR"
    exit 1
fi

DIFF_LOG="$APPFORGE_TMPDIR/diff-check-$$.log"
WIKI_AUDIT_LOG="$APPFORGE_TMPDIR/wiki-audit-$$.log"
WIKI_SECRET_LOG="$APPFORGE_TMPDIR/wiki-secret-$$.log"
WIKI_PRUNE_LOG="$APPFORGE_TMPDIR/wiki-prune-$$.log"

cleanup_tmp() {
    rm -f "$DIFF_LOG" "$WIKI_AUDIT_LOG" "$WIKI_SECRET_LOG" "$WIKI_PRUNE_LOG"
}

trap cleanup_tmp EXIT HUP INT TERM

pass() {
    printf 'PASS  %s\n' "$1"
}

fail() {
    printf 'FAIL  %s\n' "$1"
    FAIL=$((FAIL + 1))
}

echo "========================================"
echo " APPFORGE HARD STABILITY GATE V1"
echo " Mode: $MODE"
echo "========================================"

BRANCH="$(git branch --show-current 2>/dev/null || true)"
HEAD="$(git rev-parse --short HEAD 2>/dev/null || true)"

echo "Branch: $BRANCH"
echo "HEAD:   $HEAD"
echo

if [ -f AGENTS.md ] && [ -f docs/wiki/Index.md ] && [ -f docs/wiki/Hot_Context.md ]; then
    pass "Second Brain wiki core exists"
else
    fail "Second Brain wiki core missing"
fi

if node scripts/wiki-audit.mjs >"$WIKI_AUDIT_LOG" 2>&1
then
    pass "Second Brain wiki audit"
else
    cat "$WIKI_AUDIT_LOG"
    fail "Second Brain wiki audit"
fi

if python3 scripts/wiki-secret-scan.py >"$WIKI_SECRET_LOG" 2>&1
then
    pass "Second Brain wiki secret scan"
else
    cat "$WIKI_SECRET_LOG"
    fail "Second Brain wiki secret scan"
fi

if python3 scripts/wiki-prune-report.py >"$WIKI_PRUNE_LOG" 2>&1
then
    pass "Second Brain wiki prune report"
else
    cat "$WIKI_PRUNE_LOG"
    fail "Second Brain wiki prune report"
fi

is_android_proot() {
    if [ -x /system/bin/app_process ] || [ -x /system/bin/getprop ]; then
        return 0
    fi

    case "$(uname -r 2>/dev/null || true)" in
        *android*)
            return 0
            ;;
    esac

    return 1
}

safe_worktree_diff_check() {
    if ! is_android_proot; then
        git diff --check
        return
    fi

    python3 - "$ROOT" <<'PYSAFE'
from pathlib import Path
from difflib import SequenceMatcher
import subprocess
import sys

root = Path(sys.argv[1])

changed_raw = subprocess.check_output(
    [
        "git",
        "diff",
        "--name-only",
        "-z",
    ],
    cwd=root,
)

paths = [
    item.decode(
        "utf-8",
        errors="surrogateescape",
    )
    for item in changed_raw.split(b"\0")
    if item
]

errors = []

for relative in paths:
    path = root / relative

    if not path.exists() or not path.is_file():
        continue

    current = path.read_bytes()

    if b"\0" in current:
        continue

    staged = subprocess.run(
        [
            "git",
            "ls-files",
            "--stage",
            "--",
            relative,
        ],
        cwd=root,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )

    if staged.returncode != 0:
        continue

    staged_line = (
        staged.stdout
        .decode(
            "utf-8",
            errors="replace",
        )
        .strip()
    )

    if not staged_line:
        continue

    try:
        object_id = (
            staged_line
            .split(None, 3)[1]
        )
    except (IndexError, ValueError):
        continue

    baseline = subprocess.run(
        [
            "git",
            "cat-file",
            "blob",
            object_id,
        ],
        cwd=root,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )

    if baseline.returncode != 0:
        continue

    previous = baseline.stdout

    if b"\0" in previous:
        continue

    old_lines = previous.splitlines()
    new_lines = current.splitlines()

    matcher = SequenceMatcher(
        None,
        old_lines,
        new_lines,
        autojunk=False,
    )

    for tag, _, _, new_start, new_end in matcher.get_opcodes():
        if tag not in ("insert", "replace"):
            continue

        for offset, line in enumerate(
            new_lines[new_start:new_end],
            start=new_start + 1,
        ):
            if line.endswith((b" ", b"\t")):
                errors.append(
                    f"{relative}:{offset}: trailing whitespace"
                )

            leading_length = (
                len(line)
                - len(
                    line.lstrip(b" \t")
                )
            )

            leading = line[:leading_length]

            if b" \t" in leading:
                errors.append(
                    f"{relative}:{offset}: "
                    "space before tab in indentation"
                )

            if (
                line.startswith(b"<<<<<<<")
                or line.startswith(b"=======")
                or line.startswith(b">>>>>>>")
            ):
                errors.append(
                    f"{relative}:{offset}: "
                    "conflict marker"
                )

if errors:
    for error in errors:
        print(error)

    raise SystemExit(1)

print(
    "Android/proot safe diff check: PASS"
)
PYSAFE
}

if safe_worktree_diff_check >"$DIFF_LOG" 2>&1; then
    pass "git diff --check"
else
    cat "$DIFF_LOG"
    fail "git diff --check"
fi

FORBIDDEN="$(
    git diff --cached --name-status |
    awk 'BEGIN { FS = "\t" } $1 !~ /^D/ { print $NF }' |
    grep -E '(^|/)(dashboard\.sh|dashboard\.sh\.bak)$|\.apk$|\.aab$|\.save$|\.bak$' ||
    true
)"

if [ -z "$FORBIDDEN" ]; then
    pass "No forbidden staged files"
else
    echo "$FORBIDDEN"
    fail "Forbidden files are staged"
fi

TRACKED_DIRTY="$(git status --porcelain --untracked-files=no || true)"

if [ "$BRANCH" = "main" ] && [ -n "$TRACKED_DIRTY" ]; then
    fail "Tracked development change detected directly on main"
else
    pass "Branch policy"
fi

if node --check scripts/wiki-audit.mjs
then
    pass "Second Brain wiki audit syntax"
else
    fail "Second Brain wiki audit syntax"
fi

if python3 -m py_compile scripts/wiki-secret-scan.py scripts/wiki-prune-report.py
then
    pass "Second Brain wiki Python syntax"
else
    fail "Second Brain wiki Python syntax"
fi

echo
echo "========================================"

if [ "$FAIL" -eq 0 ]; then
    echo "APPFORGE STABILITY GATE: PASS"
    echo "fail 0"
    exit 0
fi

echo "APPFORGE STABILITY GATE: BLOCKED"
echo "fail $FAIL"
exit 1\n