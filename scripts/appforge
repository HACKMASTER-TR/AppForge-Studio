#!/usr/bin/env python3
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
POLICY_PATH = ROOT / ".appforge" / "policy.json"
STATE_DIR = ROOT / ".appforge" / "state"
REPORT_DIR = ROOT / ".appforge" / "reports"
LOCK_PATH = STATE_DIR / "autopilot.lock"
LATEST_STATE = STATE_DIR / "latest.json"

SECRET_PATTERNS = [
    re.compile(r"ghp_[A-Za-z0-9]{20,}"),
    re.compile(r"github_pat_[A-Za-z0-9_]{20,}"),
    re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----"),
    re.compile(r"\bAKIA[0-9A-Z]{16}\b"),
    re.compile(r"\bsk-[A-Za-z0-9_-]{20,}\b"),
]

OBSOLETE_AUTOFOLLOW = (
    r"/LaunchedEffect\(\s*state\.id,"
    r"\s*state\.snapshot\.lines\.size,"
    r"\s*state\.snapshot\.cursorLine\s*\)/"
)

def policy():
    return json.loads(POLICY_PATH.read_text(encoding="utf-8"))

def run(cmd, *, check=True, capture=False, env=None):
    proc = subprocess.run(
        cmd,
        cwd=ROOT,
        text=True,
        shell=isinstance(cmd, str),
        capture_output=capture,
        env=env,
    )
    if check and proc.returncode != 0:
        if capture:
            sys.stdout.write(proc.stdout or "")
            sys.stderr.write(proc.stderr or "")
        raise SystemExit(proc.returncode)
    return proc

def git(*args, check=True):
    return run(["git", *args], check=check, capture=True)

def git_out(*args):
    p = git(*args, check=False)
    return (p.stdout or "").strip()

def now_iso():
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def parse_gh_datetime(value):
    value = str(value or "").strip()

    if not value:
        return None

    if value.endswith("Z"):
        value = value[:-1] + "+00:00"

    try:
        return dt.datetime.fromisoformat(value)
    except ValueError:
        return None


def format_elapsed(seconds):
    seconds = max(
        0,
        int(seconds or 0),
    )

    hours, remainder = divmod(
        seconds,
        3600,
    )

    minutes, seconds = divmod(
        remainder,
        60,
    )

    return (
        f"{hours:02d}:"
        f"{minutes:02d}:"
        f"{seconds:02d}"
    )


def workflow_run_seconds(run_data):
    started = (
        parse_gh_datetime(
            run_data.get("startedAt")
        )
        or parse_gh_datetime(
            run_data.get("createdAt")
        )
    )

    finished = parse_gh_datetime(
        run_data.get("updatedAt")
    )

    if not started or not finished:
        return None

    return max(
        0,
        int(
            (
                finished
                - started
            ).total_seconds()
        ),
    )


def ci_timing_label(key):
    labels = {
        "android-debug.yml":
            "AppForge Android Debug",

        "worker-image.yml":
            "Build AppForge Worker Image",

        "source-worker-image.yml":
            "Build AppForge Source Worker Image",

        "conversion-smoke.yml":
            "AppForge Conversion Smoke",

        "production:worker-image.yml":
            "Production Automation · Worker",

        "production:source-worker-image.yml":
            "Production Automation · Source Worker",
    }

    return labels.get(
        key,
        key,
    )


def ci_timing_summary(results):
    workflows = []
    starts = []
    finishes = []

    for key, runs in results.items():
        if not isinstance(runs, list):
            continue

        for run_data in runs:
            started = (
                parse_gh_datetime(
                    run_data.get("startedAt")
                )
                or parse_gh_datetime(
                    run_data.get("createdAt")
                )
            )

            finished = parse_gh_datetime(
                run_data.get("updatedAt")
            )

            seconds = workflow_run_seconds(
                run_data
            )

            if (
                started is None
                or finished is None
                or seconds is None
            ):
                continue

            starts.append(started)
            finishes.append(finished)

            workflows.append(
                {
                    "key": key,
                    "label": ci_timing_label(key),
                    "seconds": seconds,
                    "duration":
                        format_elapsed(seconds),
                    "started_at":
                        started.isoformat(),
                    "finished_at":
                        finished.isoformat(),
                }
            )

    total_seconds = 0

    if starts and finishes:
        total_seconds = max(
            0,
            int(
                (
                    max(finishes)
                    - min(starts)
                ).total_seconds()
            ),
        )

    return {
        "workflows": workflows,
        "total_seconds": total_seconds,
        "total_duration":
            format_elapsed(total_seconds),
    }

def state_write(status, **extra):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    data = {
        "status": status,
        "updated_at": now_iso(),
        "branch": git_out("branch", "--show-current"),
        "head": git_out("rev-parse", "HEAD"),
        **extra,
    }
    LATEST_STATE.write_text(
        json.dumps(data, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )
    return data

def changed_files():
    names = set()
    for args in [
        ("diff", "--name-only"),
        ("diff", "--cached", "--name-only"),
        ("ls-files", "--others", "--exclude-standard"),
    ]:
        text = git_out(*args)
        for line in text.splitlines():
            line = line.strip()
            if line:
                names.add(line)
    return sorted(names)

def status_files():
    return changed_files()

def forbidden_files(files):
    regs = [re.compile(p) for p in policy()["forbidden_patterns"]]
    return [f for f in files if any(r.search(f) for r in regs)]

def scan_secrets():
    data = ""
    for args in [("diff", "--"), ("diff", "--cached", "--")]:
        p = git(*args, check=False)
        data += "\n" + (p.stdout or "")
    return [rx.pattern for rx in SECRET_PATTERNS if rx.search(data)]

def repair_known_stale_contracts():
    """
    Only exact, previously verified contract migrations are auto-fixed.
    Unknown stale assertions remain BLOCKED rather than being guessed.
    """
    tests = ROOT / "build-service" / "tests"
    repaired = []

    known = {
        (
            tests /
            "appforge_terminal_stage11h_owner_quick_actions_contract.test.js"
        ): [
            (
                """  assert.ok(
    source.includes('"./dashboard.sh; else "')
  );
""",
                """  assert.ok(
    source.includes('"./scripts/appforge dashboard\\\\r"')
  );

  assert.doesNotMatch(
    source,
    /\\.\\/dashboard\\.sh/
  );
"""
            )
        ]
    }


    for path, migrations in known.items():
        if not path.exists():
            continue

        text = path.read_text(
            encoding="utf-8",
            errors="ignore"
        )

        original = text

        for old, new in migrations:
            if old in text:
                text = text.replace(
                    old,
                    new,
                    1
                )

        if text != original:
            path.write_text(
                text,
                encoding="utf-8"
            )
            repaired.append(
                str(
                    path.relative_to(ROOT)
                )
            )

    if repaired:
        print(
            "AUTO-REPAIRED STALE CONTRACTS:"
        )
        for item in repaired:
            print(" -", item)

    return repaired


def stale_contracts():
    hits = []
    tests = ROOT / "build-service" / "tests"

    for path in tests.glob(
        "appforge_terminal_*.test.js"
    ):
        text = path.read_text(
            encoding="utf-8",
            errors="ignore"
        )

        reasons = []

        if OBSOLETE_AUTOFOLLOW in text:
            reasons.append(
                "obsolete-autofollow-regex"
            )

        if '"./dashboard.sh; else "' in text:
            reasons.append(
                "legacy-dashboard-command"
            )

        if reasons:
            hits.append(
                {
                    "path": str(
                        path.relative_to(ROOT)
                    ),
                    "reasons": reasons,
                }
            )

    return hits

def classify(files):
    groups = set()
    for f in files:
        if f.startswith("android-app/"):
            groups.add("android")
        if "worker" in f.lower() or f.startswith("build-service/"):
            groups.add("worker")
        if f.startswith(".github/") or "deploy" in f.lower():
            groups.add("deploy")
        if "conversion" in f.lower():
            groups.add("conversion")
        if f.startswith("android-app/app/src/main/java/com/appforge/studio/terminal/"):
            groups.add("terminal")
        if f.startswith(".secondbrain/") or f.startswith("SECOND_BRAIN"):
            groups.add("secondbrain")
    return sorted(groups)

def targeted_tests(files):
    tests_dir = ROOT / "build-service" / "tests"
    selected = set()

    if "terminal" in classify(files):
        selected.update(tests_dir.glob("appforge_terminal_*.test.js"))

    if any(".appforge/" in f or f == "scripts/appforge" for f in files):
        selected.update(tests_dir.glob("appforge_autopilot_*.test.js"))
        p = tests_dir / "appforge_admin_autopilot_controls_contract.test.js"
        if p.exists():
            selected.add(p)

    for name in [
        "appforge_terminal_shortcut_viewport_suppression_contract.test.js",
        "appforge_terminal_viewport_stability_contract.test.js",
        "appforge_terminal_ime_open_visibility_contract.test.js",
        "appforge_terminal_prompt_visibility_contract.test.js",
    ]:
        p = tests_dir / name
        if p.exists():
            selected.add(p)

    return sorted(selected)

def security_gate(files):
    repair_known_stale_contracts()

    files = changed_files()

    bad = forbidden_files(files)
    if bad:
        print("FORBIDDEN FILES:")
        for f in bad:
            print(" -", f)
        return False

    secrets = scan_secrets()
    if secrets:
        print("SECRET SCAN: BLOCKED")
        for hit in secrets:
            print(" -", hit)
        return False

    stale = stale_contracts()
    if stale:
        print("STALE CONTRACT DETECTED:")
        for item in stale:
            print(
                " -",
                item["path"],
                ":",
                ",".join(
                    item["reasons"]
                )
            )
        return False

    print("SECURITY / STALE CONTRACT SCAN: PASS")
    return True

def local_gate():
    repair_known_stale_contracts()

    files = changed_files()
    print("=== CHANGE IMPACT ===")
    print("Files:", len(files))
    print("Groups:", ", ".join(classify(files)) or "none")

    if not security_gate(files):
        raise SystemExit(10)

    print("\n=== DIFF CHECK ===")
    run(["git", "diff", "--check"])

    selected = targeted_tests(files)
    print("\n=== TARGETED REGRESSION ===")
    if selected:
        run(["node", "--test", *[str(p.relative_to(ROOT)) for p in selected]])
    else:
        print("No targeted tests selected.")

    print("\n=== FULL REGRESSION ===")
    run(["npm", "--prefix", "build-service", "test"])

    print("\n=== SECOND BRAIN SELFTEST ===")
    run(["./scripts/brain", "selftest"])

    print("\n=== SECOND BRAIN DOCTOR ===")
    doctor = run(["./scripts/brain", "doctor"], capture=True)
    sys.stdout.write(doctor.stdout or "")
    if '"status": "PASS"' not in (doctor.stdout or ""):
        raise SystemExit(11)

    print("\n=== HARD STABILITY GATE ===")
    run(["./scripts/appforge-stability-gate", "local"])

    print("\nLOCAL_GATES: PASS")
    print("fail 0")

def safe_stage():
    files = changed_files()
    bad = forbidden_files(files)
    if bad:
        raise SystemExit("Forbidden file present; refusing to stage.")
    if not files:
        raise SystemExit("No changes to stage.")
    run(["git", "add", "--", *files])

def default_commit_message():
    branch = git_out("branch", "--show-current")
    tail = branch.split("/", 1)[-1].replace("-", " ").strip()
    if branch.startswith("fix/"):
        return f"Fix {tail}"
    if branch.startswith("feat/") or branch.startswith("feature/"):
        return f"Add {tail}"
    return f"Update {tail or 'AppForge'}"

def github_repo():
    remote = git_out(
        "remote",
        "get-url",
        "origin",
    ).strip()

    if remote.startswith(
        "git@github.com:"
    ):
        slug = remote.split(
            ":",
            1,
        )[1]
    elif "github.com/" in remote:
        slug = remote.split(
            "github.com/",
            1,
        )[1]
    else:
        raise SystemExit(
            "BLOCKED: origin GitHub repository "
            "olarak çözülemedi."
        )

    slug = (
        slug
        .removesuffix(".git")
        .strip("/")
    )

    if slug.count("/") != 1:
        raise SystemExit(
            "BLOCKED: GitHub repository slug "
            "geçersiz."
        )

    return slug


def gh_required():
    if not shutil.which("gh"):
        raise SystemExit("gh CLI bulunamadı; PR/CI otomasyonu BLOCKED.")
    p = run(["gh", "auth", "status"], check=False, capture=True)
    if p.returncode != 0:
        sys.stdout.write(p.stdout or "")
        sys.stderr.write(p.stderr or "")
        raise SystemExit("GitHub auth geçersiz; PR/CI otomasyonu BLOCKED.")

def pr_number():
    repo = github_repo()

    branch = git_out(
        "branch",
        "--show-current",
    )

    p = run([
        "gh",
        "api",
        (
            f"repos/{repo}/pulls"
            "?state=open&per_page=100"
        ),
    ], check=False, capture=True)

    if p.returncode != 0:
        return None

    try:
        pulls = json.loads(
            p.stdout or "[]"
        )
    except json.JSONDecodeError:
        return None

    matches = []

    for pr in pulls:
        head = (
            pr.get("head")
            or {}
        )

        base = (
            pr.get("base")
            or {}
        )

        head_repo = (
            head.get("repo")
            or {}
        )

        if (
            head.get("ref") == branch
            and base.get("ref") == "main"
            and str(
                head_repo.get(
                    "full_name"
                )
                or ""
            ).lower()
            == repo.lower()
        ):
            matches.append(pr)

    if not matches:
        return None

    matches.sort(
        key=lambda pr:
            int(
                pr.get("number")
                or 0
            ),
        reverse=True,
    )

    value = matches[0].get(
        "number"
    )

    return (
        int(value)
        if value is not None
        else None
    )


def ensure_pr():
    num = pr_number()

    if num:
        return num

    repo = github_repo()
    branch = git_out(
        "branch",
        "--show-current",
    )

    title = default_commit_message()

    body = (
        "## AppForge Autopilot\n\n"
        "- Local targeted regression: PASS\n"
        "- Full regression: PASS\n"
        "- Second Brain: PASS\n"
        "- Hard stability gate: PASS\n"
        "- fail 0\n"
        "- Security/stale-contract scan: PASS\n\n"
        "Do not merge unless all required CI "
        "checks are SUCCESS."
    )

    p = run([
        "gh",
        "api",
        "-X",
        "POST",
        f"repos/{repo}/pulls",
        "-f",
        f"head={branch}",
        "-f",
        "base=main",
        "-f",
        f"title={title}",
        "-f",
        f"body={body}",
        "--jq",
        ".number",
    ], check=False, capture=True)

    if p.returncode != 0:
        # GitHub returns 422 when an open PR already
        # exists for the same head/base pair. Resolve
        # the existing PR before treating it as fatal.
        existing = pr_number()

        if existing:
            print(
                f"PR #{existing}: "
                "existing open PR reused"
            )
            return existing

        sys.stdout.write(
            p.stdout or ""
        )
        sys.stderr.write(
            p.stderr or ""
        )

        raise SystemExit(
            "PR oluşturma başarısız."
        )

    value = (
        p.stdout
        or ""
    ).strip()

    if not value.isdigit():
        raise SystemExit(
            "PR oluşturuldu ancak "
            "numarası çözülemedi."
        )

    return int(value)


def pr_head_sha(num):
    repo = github_repo()

    p = run([
        "gh",
        "api",
        f"repos/{repo}/pulls/{num}",
        "--jq",
        ".head.sha",
    ], check=False, capture=True)

    value = (
        p.stdout
        or ""
    ).strip()

    if (
        p.returncode != 0
        or not value
    ):
        raise SystemExit(
            "PR HEAD SHA çözülemedi."
        )

    return value


def latest_check_runs(head_sha):
    repo = github_repo()

    p = run([
        "gh",
        "api",
        (
            f"repos/{repo}/commits/"
            f"{head_sha}/check-runs"
            "?per_page=100"
        ),
    ], check=False, capture=True)

    if p.returncode != 0:
        return None

    try:
        payload = json.loads(
            p.stdout or "{}"
        )
    except json.JSONDecodeError:
        return None

    latest = {}

    for item in payload.get(
        "check_runs",
        [],
    ):
        name = str(
            item.get("name")
            or ""
        )

        if not name:
            continue

        current = latest.get(name)

        if (
            current is None
            or int(
                item.get("id")
                or 0
            )
            > int(
                current.get("id")
                or 0
            )
        ):
            latest[name] = item

    return list(
        latest.values()
    )


def ci_watch():
    gh_required()

    num = pr_number()

    if not num:
        raise SystemExit(
            "Aktif branch için PR bulunamadı."
        )

    head_sha = pr_head_sha(num)

    print(
        f"Watching PR #{num} checks "
        "every 10 seconds..."
    )

    started = time.time()

    while time.time() - started < 5400:
        checks = latest_check_runs(
            head_sha
        )

        if checks is None:
            time.sleep(10)
            continue

        if not checks:
            print(
                "Checks henüz başlamadı..."
            )
            time.sleep(10)
            continue

        running = [
            item
            for item in checks
            if item.get("status")
            != "completed"
        ]

        failed = [
            item
            for item in checks
            if (
                item.get("status")
                == "completed"
                and item.get("conclusion")
                not in {
                    "success",
                    "neutral",
                    "skipped",
                }
            )
        ]

        print(
            "Checks:",
            f"total={len(checks)}",
            f"running={len(running)}",
            f"failed={len(failed)}",
        )

        if failed:
            for item in failed:
                print(
                    "FAILED:",
                    item.get("name"),
                    item.get("conclusion"),
                )

            raise SystemExit(
                "PR REQUIRED CI FAILED."
            )

        if not running:
            for item in sorted(
                checks,
                key=lambda value:
                    str(
                        value.get("name")
                        or ""
                    ),
            ):
                print(
                    item.get("name"),
                    item.get("conclusion"),
                )

            return

        time.sleep(10)

    raise SystemExit(
        "PR CI timeout."
    )


def merge_pr(num):
    repo = github_repo()

    p = run([
        "gh",
        "api",
        f"repos/{repo}/pulls/{num}",
    ], check=True, capture=True)

    try:
        pr = json.loads(
            p.stdout or "{}"
        )
    except json.JSONDecodeError:
        raise SystemExit(
            "PR metadata çözülemedi."
        )

    head = (
        pr.get("head")
        or {}
    )

    head_sha = str(
        head.get("sha")
        or ""
    )

    head_ref = str(
        head.get("ref")
        or ""
    )

    if not head_sha:
        raise SystemExit(
            "PR merge için HEAD SHA yok."
        )

    result = run([
        "gh",
        "api",
        "-X",
        "PUT",
        f"repos/{repo}/pulls/{num}/merge",
        "-f",
        "merge_method=merge",
        "-f",
        f"sha={head_sha}",
    ], check=False, capture=True)

    try:
        data = json.loads(
            result.stdout or "{}"
        )
    except json.JSONDecodeError:
        data = {}

    if (
        result.returncode != 0
        or data.get("merged")
        is not True
    ):
        sys.stdout.write(
            result.stdout or ""
        )
        sys.stderr.write(
            result.stderr or ""
        )

        raise SystemExit(
            "PR merge başarısız."
        )

    if head_ref:
        delete = run([
            "git",
            "push",
            "origin",
            "--delete",
            head_ref,
        ], check=False, capture=True)

        if delete.returncode != 0:
            print(
                "WARN: merged branch remote "
                "üzerinden silinemedi."
            )


def workflow_display_name(workflow_file):
    path = (
        ROOT /
        ".github" /
        "workflows" /
        workflow_file
    )

    if not path.is_file():
        raise SystemExit(
            "BLOCKED: workflow file bulunamadı: "
            f"{workflow_file}"
        )

    for raw in path.read_text(
        encoding="utf-8"
    ).splitlines():
        line = raw.strip()

        if line.startswith("name:"):
            name = (
                line.split(":", 1)[1]
                .strip()
                .strip('"')
                .strip("'")
            )

            if name:
                return name

    raise SystemExit(
        "BLOCKED: workflow name çözülemedi: "
        f"{workflow_file}"
    )


def wait_workflow(
    workflow_file,
    head_sha,
    timeout=5400,
    min_count=1,
    event_filter=None,
    display_title=None,
):
    name = workflow_display_name(
        workflow_file
    )

    started = time.time()

    while time.time() - started < timeout:
        p = run([
            "gh",
            "run",
            "list",
            "--workflow",
            workflow_file,
            "--branch",
            "main",
            "--limit",
            "40",
            "--json",
            (
                "databaseId,headSha,status,"
                "conclusion,url,createdAt,"
                "startedAt,updatedAt,"
                "event,displayTitle"
            ),
        ], check=False, capture=True)

        if p.returncode != 0:
            time.sleep(15)
            continue

        try:
            runs = json.loads(
                p.stdout or "[]"
            )
        except json.JSONDecodeError:
            runs = []

        matches = [
            r
            for r in runs
            if (
                r.get("headSha") == head_sha
                and (
                    event_filter is None
                    or r.get("event") == event_filter
                )
                and (
                    display_title is None
                    or r.get("displayTitle")
                    == display_title
                )
            )
        ]

        matches.sort(
            key=lambda r:
                int(
                    r.get(
                        "databaseId"
                    )
                    or 0
                ),
            reverse=True,
        )

        selected = matches[:min_count]

        if len(selected) < min_count:
            print(
                f"{name}: waiting "
                f"({len(selected)}/{min_count})"
            )
            time.sleep(15)
            continue

        pending = [
            r
            for r in selected
            if r.get("status")
            != "completed"
        ]

        if pending:
            print(
                f"{name}: "
                f"{len(selected) - len(pending)}/"
                f"{len(selected)} completed"
            )
            time.sleep(15)
            continue

        failed = [
            r
            for r in selected
            if r.get("conclusion")
            != "success"
        ]

        if failed:
            states = ", ".join(
                str(
                    r.get("conclusion")
                )
                for r in failed
            )

            raise SystemExit(
                f"{name}: {states}"
            )

        print(
            f"{name}: "
            f"{len(selected)}/"
            f"{len(selected)} SUCCESS"
        )

        for run_data in selected:
            elapsed = workflow_run_seconds(
                run_data
            )

            if elapsed is not None:
                print(
                    f"⏱ {name}: "
                    f"{format_elapsed(elapsed)}"
                )

        return selected

    raise SystemExit(
        f"{name}: timeout"
    )

def release_info():
    gh_required()
    p = run([
        "gh", "release", "view", "appforge-studio-latest",
        "--json", "tagName,publishedAt,url,assets",
    ], check=False, capture=True)

    if p.returncode != 0:
        return {"status": "NOT_READY"}

    data = json.loads(p.stdout or "{}")
    apks = [
        a for a in data.get("assets", [])
        if str(a.get("name", "")).lower().endswith(".apk")
    ]
    return {
        "status": "READY" if apks else "NO_APK",
        "tag": data.get("tagName"),
        "publishedAt": data.get("publishedAt"),
        "url": data.get("url"),
        "apk_assets": [
            {
                "name": a.get("name"),
                "size": a.get("size"),
                "downloadCount": a.get("downloadCount"),
            }
            for a in apks
        ],
    }

def generate_report(result, **extra):
    REPORT_DIR.mkdir(parents=True, exist_ok=True)
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    data = {
        "result": result,
        "timestamp": now_iso(),
        "branch": git_out("branch", "--show-current"),
        "head": git_out("rev-parse", "HEAD"),
        "main": git_out("rev-parse", "main"),
        "changed_files": changed_files(),
        "groups": classify(changed_files()),
        **extra,
    }

    json_path = REPORT_DIR / f"{stamp}-pipeline.json"
    md_path = REPORT_DIR / f"{stamp}-pipeline.md"

    json_path.write_text(
        json.dumps(data, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )

    md = [
        "# AppForge Pipeline Report",
        "",
        f"- Result: **{result}**",
        f"- Timestamp: `{data['timestamp']}`",
        f"- Branch: `{data['branch']}`",
        f"- HEAD: `{data['head']}`",
        f"- Main: `{data['main']}`",
        f"- Groups: `{', '.join(data['groups']) or 'none'}`",
        "",
        "## Validation",
        "",
        "- Targeted regression: PASS",
        "- Full regression: PASS",
        "- Second Brain: PASS",
        "- Hard Stability Gate: PASS",
        "- fail 0",
        "",
        "## Extra",
        "",
        "```json",
        json.dumps(extra, ensure_ascii=False, indent=2),
        "```",
        "",
    ]
    md_path.write_text("\n".join(md), encoding="utf-8")
    return json_path, md_path

class Lock:
    def __enter__(self):
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        if LOCK_PATH.exists():
            age = time.time() - LOCK_PATH.stat().st_mtime
            if age < 6 * 3600:
                raise SystemExit("Başka bir AppForge pipeline kilidi aktif.")
            LOCK_PATH.unlink(missing_ok=True)
        LOCK_PATH.write_text(
            json.dumps({"pid": os.getpid(), "started_at": now_iso()}) + "\n",
            encoding="utf-8",
        )
        return self

    def __exit__(self, exc_type, exc, tb):
        LOCK_PATH.unlink(missing_ok=True)

def branch_change_files():
    run(
        ["git", "fetch", "origin", "main"],
        check=False,
    )

    p = git(
        "diff",
        "--name-only",
        "origin/main...HEAD",
        check=False,
    )

    return sorted(
        line.strip()
        for line in (p.stdout or "").splitlines()
        if line.strip()
    )


def require_remote_sync(branch):
    run(
        ["git", "fetch", "origin"],
        check=True,
    )

    local_sha = git_out(
        "rev-parse",
        "HEAD",
    )

    remote_ref = f"origin/{branch}"

    remote_sha = git_out(
        "rev-parse",
        remote_ref,
    )

    if not remote_sha:
        raise SystemExit(
            "BLOCKED: remote branch bulunamadı."
        )

    if local_sha != remote_sha:
        raise SystemExit(
            "BLOCKED: local HEAD ile remote HEAD farklı."
        )

    print(
        "COMMIT/PUSH: ALREADY COMPLETE"
    )
    print(
        "HEAD:",
        local_sha[:12],
    )

    return local_sha


def is_fast_lane_file(path):
    if path.startswith(
        "build-service/tests/"
    ):
        return True

    if path in {
        "scripts/appforge",
        "scripts/appforge-stability-gate",
        ".github/scripts/railway_production.py",
    }:
        return True

    if path.startswith(
        ".github/workflows/"
    ):
        return True

    if path.startswith(
        ".secondbrain/"
    ):
        return True

    if path.startswith(
        ".appforge/"
    ):
        return True

    if path.startswith(
        "docs/"
    ):
        return True

    if path.endswith(".md"):
        return True

    return False


def pipeline_mode(files):
    return (
        "FAST"
        if not required_main_workflows(
            files
        )
        else "FULL"
    )


def required_main_workflows(files):
    runtime_files = [
        f
        for f in files
        if not is_fast_lane_file(f)
    ]

    required = []

    android_change = any(
        f.startswith(
            "android-app/"
        )
        for f in runtime_files
    )

    if android_change:
        required.append(
            "android-debug.yml"
        )

    build_runtime_files = [
        f
        for f in runtime_files
        if f.startswith(
            "build-service/"
        )
    ]

    source_only = {
        "build-service/Dockerfile.source-worker",
        "build-service/source-worker.js",
        (
            "build-service/scripts/"
            "patch-flutter-readonly-sdk.sh"
        ),
        (
            "build-service/scripts/"
            "source-worker-runtime-smoke.sh"
        ),
    }

    normal_worker_change = any(
        f not in source_only
        for f in build_runtime_files
    )

    if normal_worker_change:
        required.append(
            "worker-image.yml"
        )

    source_worker_ci_change = (
        ".github/workflows/source-worker-image.yml"
        in files
    )

    if (
        build_runtime_files
        or source_worker_ci_change
    ):
        required.append(
            "source-worker-image.yml"
        )

    conversion_android_files = {
        (
            "android-app/app/src/main/java/"
            "com/appforge/studio/"
            "MainActivity.kt"
        ),
        (
            "android-app/app/src/main/java/"
            "com/appforge/studio/io/"
            "AppForgeApkConversion.kt"
        ),
        (
            "android-app/app/src/main/java/"
            "com/appforge/studio/io/"
            "AppForgeExeConversion.kt"
        ),
    }

    conversion_change = (
        bool(build_runtime_files)
        or any(
            f in conversion_android_files
            for f in runtime_files
        )
    )

    if conversion_change:
        required.append(
            "conversion-smoke.yml"
        )

    return list(
        dict.fromkeys(required)
    )


def wait_required_main_ci(
    head_sha,
    source_files,
):
    required = required_main_workflows(
        source_files
    )

    mode = pipeline_mode(
        source_files
    )

    print(
        f"\nPIPELINE MODE: {mode}"
    )

    results = {}

    print(
        "\n=== MAIN REQUIRED CI ==="
    )

    if not required:
        print(
            "FAST LANE: "
            "heavy runtime CI skipped."
        )

        return required, results

    for workflow_file in required:
        state_write(
            "BUILDING",
            workflow=workflow_file,
            main_sha=head_sha,
        )

        results[workflow_file] = (
            wait_workflow(
                workflow_file,
                head_sha,
            )
        )

    production_map = {
        "worker-image.yml":
            (
                "Production · "
                "Build AppForge Worker Image"
            ),

        "source-worker-image.yml":
            (
                "Production · "
                "Build AppForge Source Worker Image"
            ),
    }

    production_targets = [
        (
            workflow_file,
            production_map[
                workflow_file
            ],
        )
        for workflow_file in required
        if workflow_file
        in production_map
    ]

    if production_targets:
        print(
            "\n=== PRODUCTION AUTOMATION ==="
        )

    for (
        upstream_workflow,
        title
    ) in production_targets:
        key = (
            "production:"
            + upstream_workflow
        )

        state_write(
            "DEPLOYING",
            workflow=key,
            main_sha=head_sha,
        )

        results[key] = wait_workflow(
            "production-automation.yml",
            head_sha,
            min_count=1,
            event_filter="workflow_run",
            display_title=title,
        )

    timing = ci_timing_summary(
        results
    )

    print(
        "\n=== PIPELINE TIMING ==="
    )

    for item in timing["workflows"]:
        print(
            f"⏱ {item['label']}: "
            f"{item['duration']}"
        )

    print(
        "----------------------------------------"
    )

    print(
        "🏁 FULL PIPELINE TOTAL: "
        f"{timing['total_duration']}"
    )

    results["_timing"] = timing

    return required, results

def continue_after_push(branch):
    source_files = branch_change_files()
    source_groups = classify(source_files)
    source_mode = pipeline_mode(
        source_files
    )

    print("\n=== PIPELINE IMPACT ===")
    print(
        "PIPELINE MODE:",
        source_mode,
    )
    print(
        "Files:",
        len(source_files),
    )
    print(
        "Groups:",
        ", ".join(source_groups)
        or "none",
    )

    gh_required()

    state_write(
        "OPENING_PR"
    )

    num = ensure_pr()

    print(
        f"PR #{num}: READY"
    )

    state_write(
        "WAITING_CI",
        pr=num,
    )

    ci_watch()

    print(
        "\nPR REQUIRED CI: SUCCESS"
    )

    state_write(
        "MERGING",
        pr=num,
    )

    merge_pr(num)

    print(
        f"PR #{num}: MERGED"
    )

    run([
        "git",
        "switch",
        "main",
    ])

    run([
        "git",
        "pull",
        "--ff-only",
        "origin",
        "main",
    ])

    main_sha = git_out(
        "rev-parse",
        "HEAD",
    )

    required_workflows, ci_result = (
        wait_required_main_ci(
            main_sha,
            source_files,
        )
    )

    rel = release_info()

    if (
        "android-debug.yml"
        in required_workflows
        and rel.get("status") != "READY"
    ):
        raise SystemExit(
            "Latest APK release henüz READY değil."
        )

    state_write(
        "COMPLETE",
        pr=num,
        release=rel,
        source_files=source_files,
        source_groups=source_groups,
        required_workflows=required_workflows,
    )

    jp, mp = generate_report(
        "SUCCESS",
        pr=num,
        source_branch=branch,
        source_files=source_files,
        source_groups=source_groups,
        required_workflows=required_workflows,
        ci=ci_result,
        release=rel,
    )

    print(
        "\nAPPFORGE PIPELINE COMPLETE ✅"
    )
    print(
        "JSON:",
        jp,
    )
    print(
        "REPORT:",
        mp,
    )


def recover():
    if git_out(
        "branch",
        "--show-current",
    ) != "main":
        raise SystemExit(
            "recover yalnız main üzerinde çalışır."
        )

    sha = (
        os.environ.get(
            "APPFORGE_RECOVERY_SHA"
        )
        or ""
    ).strip()

    if not sha:
        raise SystemExit(
            "APPFORGE_RECOVERY_SHA gerekli."
        )

    run([
        "git",
        "fetch",
        "origin",
        "main",
    ])

    if not git_out(
        "cat-file",
        "-t",
        sha,
    ):
        raise SystemExit(
            "Recovery SHA bulunamadı."
        )

    first_parent = git_out(
        "rev-parse",
        f"{sha}^1",
    )

    diff = git_out(
        "diff",
        "--name-only",
        first_parent,
        sha,
    )

    files = [
        line.strip()
        for line in diff.splitlines()
        if line.strip()
    ]

    print(
        "=== APPFORGE MAIN RECOVERY ==="
    )
    print(
        "SHA:",
        sha,
    )
    print(
        "Files:",
        len(files),
    )

    required, ci_result = (
        wait_required_main_ci(
            sha,
            files,
        )
    )

    rel = release_info()

    if (
        "android-debug.yml"
        in required
        and rel.get("status") != "READY"
    ):
        raise SystemExit(
            "APK release READY değil."
        )

    state_write(
        "COMPLETE",
        recovery_sha=sha,
        required_workflows=required,
        release=rel,
    )

    jp, mp = generate_report(
        "SUCCESS",
        recovery_sha=sha,
        source_files=files,
        required_workflows=required,
        ci=ci_result,
        release=rel,
    )

    print(
        "\nAPPFORGE RECOVERY COMPLETE ✅"
    )
    print(
        "JSON:",
        jp,
    )
    print(
        "REPORT:",
        mp,
    )

def submit():
    branch = git_out(
        "branch",
        "--show-current",
    )

    if branch == "main":
        raise SystemExit(
            "main üzerinde submit yasak."
        )

    with Lock():
        state_write(
            "TESTING"
        )

        local_gate()

        files = changed_files()

        if files:
            print(
                "\n=== NEW LOCAL CHANGES ==="
            )

            safe_stage()

            run([
                "git",
                "diff",
                "--cached",
                "--check",
            ])

            run([
                "./scripts/appforge-stability-gate",
                "local",
            ])

            msg = (
                os.environ.get(
                    "APPFORGE_COMMIT_MESSAGE"
                )
                or default_commit_message()
            )

            state_write(
                "COMMITTING",
                commit_message=msg,
            )

            run([
                "git",
                "commit",
                "-m",
                msg,
            ])

            state_write(
                "PUSHING"
            )

            run([
                "git",
                "push",
                "-u",
                "origin",
                branch,
            ])

            print(
                "COMMIT/PUSH: SUCCESS"
            )

        else:
            print(
                "\n=== RESUME DETECTED ==="
            )

            require_remote_sync(
                branch
            )

        continue_after_push(
            branch
        )


def resume():
    branch = git_out(
        "branch",
        "--show-current",
    )

    if branch == "main":
        raise SystemExit(
            "main üzerinde resume yapılamaz."
        )

    if changed_files():
        raise SystemExit(
            "BLOCKED: resume için worktree "
            "temiz olmalı. Yeni değişiklik varsa "
            "'appforge submit' kullan."
        )

    with Lock():
        print(
            "=== APPFORGE RESUME ==="
        )

        require_remote_sync(
            branch
        )

        state_write(
            "RESUMING"
        )

        print(
            "\n=== REVALIDATION ==="
        )

        local_gate()

        continue_after_push(
            branch
        )

def dashboard():
    refresh = int(policy().get("dashboard_refresh_seconds", 30))
    while True:
        os.system("clear")
        latest = {}
        if LATEST_STATE.exists():
            try:
                latest = json.loads(LATEST_STATE.read_text(encoding="utf-8"))
            except Exception:
                latest = {}

        print("APPFORGE ADMIN CONTROL CENTER")
        print("=" * 44)
        print("Time:   ", now_iso())
        print("Branch: ", git_out("branch", "--show-current"))
        print("HEAD:   ", git_out("rev-parse", "--short", "HEAD"))
        print("Dirty:  ", "YES" if status_files() else "NO")
        print("State:  ", latest.get("status", "IDLE"))
        print("Refresh:", f"{refresh}s")

        if shutil.which("gh"):
            num = pr_number()

            if num:
                repo = github_repo()

                p = run([
                    "gh",
                    "api",
                    f"repos/{repo}/pulls/{num}",
                ], check=False, capture=True)

                if p.returncode == 0:
                    try:
                        pr = json.loads(
                            p.stdout or "{}"
                        )

                        print(
                            "PR:     ",
                            f"#{pr.get('number')} "
                            f"{pr.get('state')} "
                            f"{pr.get('mergeable_state')}",
                        )
                    except Exception:
                        pass

        print("\nChanged groups:", ", ".join(classify(changed_files())) or "none")
        stale = stale_contracts()
        print("Stale contracts:", "0 ✅" if not stale else f"{len(stale)} ❌")

        if latest.get("status") == "COMPLETE":
            print("\nOVERALL: COMPLETE ✅")
            return

        print("\nOVERALL:", latest.get("status", "IDLE"))
        print(f"\nNext refresh in {refresh}s")
        time.sleep(refresh)

def ci():
    gh_required()

    num = pr_number()

    if not num:
        print(
            "Aktif branch için PR yok."
        )
        return

    head_sha = pr_head_sha(num)

    checks = latest_check_runs(
        head_sha
    )

    if checks is None:
        raise SystemExit(
            "PR checks alınamadı."
        )

    if not checks:
        print(
            "PR checks henüz başlamadı."
        )
        return

    for item in sorted(
        checks,
        key=lambda value:
            str(
                value.get("name")
                or ""
            ),
    ):
        print(
            item.get("name"),
            item.get("status"),
            item.get("conclusion")
            or "-",
        )

def report():
    if not REPORT_DIR.exists():
        print("Henüz pipeline raporu yok.")
        return
    reports = sorted(REPORT_DIR.glob("*-pipeline.md"))
    if not reports:
        print("Henüz pipeline raporu yok.")
        return
    print(reports[-1].read_text(encoding="utf-8"))

def status():
    latest = {}
    if LATEST_STATE.exists():
        try:
            latest = json.loads(LATEST_STATE.read_text(encoding="utf-8"))
        except Exception:
            pass
    print("Branch:", git_out("branch", "--show-current"))
    print("HEAD:  ", git_out("rev-parse", "--short", "HEAD"))
    print("State: ", latest.get("status", "IDLE"))
    print("Files: ", len(changed_files()))
    print("Groups:", ", ".join(classify(changed_files())) or "none")
    print("Stale: ", len(stale_contracts()))
    print("Forbidden:", len(forbidden_files(changed_files())))

def release():
    print(json.dumps(release_info(), ensure_ascii=False, indent=2))

def deploy():
    adapters = policy().get("external_adapters", {})
    print("DEPLOY ADAPTERS")
    for name, mode in adapters.items():
        print(f"{name:12} {mode.upper()} / NOT_CONFIGURED until credentials are available")

def rollback():
    print(
        "ROLLBACK is policy-gated. "
        "Use a reviewed revert branch; direct destructive rollback is not automatic."
    )

def require_admin_session():
    if os.environ.get("APPFORGE_ADMIN_SESSION") != "1":
        print("PERMISSION_DENIED")
        raise SystemExit(77)


def main():
    parser = argparse.ArgumentParser(prog="appforge")
    sub = parser.add_subparsers(dest="cmd", required=True)

    for name in [
        "status", "doctor", "test", "security", "dashboard",
        "ci", "report", "submit", "resume", "recover", "release", "deploy", "rollback"
    ]:
        sub.add_parser(name)

    args = parser.parse_args()
    os.chdir(ROOT)

    admin_commands = {
        "status",
        "dashboard",
        "ci",
        "report",
        "submit",
        "resume",
        "recover",
        "release",
        "deploy",
        "rollback",
    }

    if args.cmd in admin_commands:
        require_admin_session()

    if args.cmd == "status":
        status()
    elif args.cmd == "doctor":
        local_gate()
    elif args.cmd == "test":
        files = changed_files()
        selected = targeted_tests(files)
        if selected:
            run(["node", "--test", *[str(p.relative_to(ROOT)) for p in selected]])
        run(["npm", "--prefix", "build-service", "test"])
    elif args.cmd == "security":
        if not security_gate(changed_files()):
            raise SystemExit(10)
    elif args.cmd == "dashboard":
        dashboard()
    elif args.cmd == "ci":
        ci()
    elif args.cmd == "report":
        report()
    elif args.cmd == "submit":
        submit()
    elif args.cmd == "resume":
        resume()
    elif args.cmd == "recover":
        recover()
    elif args.cmd == "release":
        release()
    elif args.cmd == "deploy":
        deploy()
    elif args.cmd == "rollback":
        rollback()

if __name__ == "__main__":
    main()
